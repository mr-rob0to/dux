#!/usr/bin/env bash
# Fake gh for tests. Records calls; there is no forge behind it.
set -u
printf '%s\n' "$*" >> "${FAKE_GH_LOG:-/dev/null}"
case "$1 ${2:-}" in
  "auth status")   exit 0 ;;
  "repo view")     echo "fake gh: no GitHub remote" >&2; exit 1 ;;
  "issue comment")
    if [ -n "${FAKE_GH_FAIL:-}" ]; then echo "fake gh: comment failed" >&2; exit 1; fi
    echo "https://example.invalid/issues/comment/1" ;;
  "issue list")
    if [ -n "${FAKE_GH_FAIL:-}" ]; then echo "fake gh: issue list failed" >&2; exit 1; fi
    # A fixture too large for an environment variable, or one a test rewrites
    # between runs, is named by a file; everything else stays a variable.
    if [ -n "${FAKE_GH_ISSUE_LIST_FILE:-}" ] && [ -f "${FAKE_GH_ISSUE_LIST_FILE:-}" ]; then
      cat "$FAKE_GH_ISSUE_LIST_FILE"
    else
      echo "${FAKE_GH_ISSUE_LIST:-[]}"
    fi ;;
  "issue view")
    # FAKE_GH_VIEW_FAIL fails the view while the list still answers, which is
    # the only way to reach the reconciliation refusal.
    if [ -n "${FAKE_GH_FAIL:-}${FAKE_GH_VIEW_FAIL:-}" ]; then echo "fake gh: issue view failed" >&2; exit 1; fi
    echo "${FAKE_GH_ISSUE_STATE:-OPEN}" ;;
  "pr list")
    if [ -n "${FAKE_GH_FAIL:-}" ]; then echo "fake gh: pr list failed" >&2; exit 1; fi
    # A test whose head commit only exists once the worker has made it points at
    # a file the worker writes; every other test keeps using the variable.
    if [ -n "${FAKE_GH_PR_LIST_FILE:-}" ] && [ -f "${FAKE_GH_PR_LIST_FILE:-}" ]; then
      cat "$FAKE_GH_PR_LIST_FILE"
    else
      echo "${FAKE_GH_PR_LIST:-[]}"
    fi ;;
  "pr checks")
    if [ -n "${FAKE_GH_FAIL:-}" ]; then echo "fake gh: pr checks failed" >&2; exit 1; fi
    echo "${FAKE_GH_PR_CHECKS:-[]}"
    # Real gh exits 8 when a pull request has no checks and 1 when one failed.
    case "${FAKE_GH_PR_CHECKS:-[]}" in
      '[]') exit 8 ;;
      *FAILURE*|*PENDING*|*CANCELLED*) exit 1 ;;
    esac ;;
  "pr view")
    if [ -n "${FAKE_GH_FAIL:-}" ]; then echo "fake gh: pr view failed" >&2; exit 1; fi
    # A caller that picks the state out with -q gets the state. One that asks for
    # the JSON gets the fields dux-round and dux-spawn read; a pull request with
    # no merge commit gets null, as GitHub gives one that is not merged.
    case " $* " in
      *" -q "*|*" --jq "*) echo "${FAKE_GH_PR_STATE:-OPEN}" ;;
      *) jq -nc --arg s "${FAKE_GH_PR_STATE:-OPEN}" --arg h "${FAKE_GH_PR_HEAD:-}" --arg b "${FAKE_GH_PR_BASE:-main}" \
           --arg o "${FAKE_GH_PR_HEAD_OID:-}" --arg m "${FAKE_GH_PR_MERGE:-}" \
           '{state: $s, headRefName: $h, baseRefName: $b, headRefOid: $o,
             mergeCommit: (if $m == "" then null else {oid: $m} end)}' ;;
    esac ;;
  "api "*)
    # Only the check runs on a commit, which dux-spawn asks for by name.
    if [ -n "${FAKE_GH_FAIL:-}${FAKE_GH_API_FAIL:-}" ]; then echo "fake gh: api failed" >&2; exit 1; fi
    # The default is a variable: bash 3.2 keeps the backslash of an escaped
    # brace inside ${var:-...}, and the JSON is then unreadable.
    none='{"check_runs":[]}'
    echo "${FAKE_GH_CHECK_RUNS:-$none}" ;;
  *) echo "fake gh: unhandled: $*" >&2; exit 2 ;;
esac
