#!/usr/bin/env bash
# Fake herdr CLI for tests. Records calls; returns canned JSON.
# Live tabs live in $FAKE_HERDR_LOG.tabs, one "<tab_id> <pane_id|-> <label>" per
# line, so tab list and pane list answer for the tabs this fake actually holds.
set -u
printf '%s\n' "$*" >> "${FAKE_HERDR_LOG:-/dev/null}"
tabs=""; [ -n "${FAKE_HERDR_LOG:-}" ] && tabs="$FAKE_HERDR_LOG.tabs"
# Where `pane run` records the pid it started, for `pane process-info` to answer about.
procpid="${FAKE_HERDR_LOG:-/dev/null}.procpid"

remember() {  # $1 tab_id, $2 pane_id or -, $3 label
  [ -n "$tabs" ] || return 0
  printf '%s %s %s\n' "$1" "$2" "$3" >> "$tabs"
}

forget() {  # $1 a tab id or a pane id; drops the row either names
  { [ -n "$tabs" ] && [ -f "$tabs" ]; } || return 0
  awk -v k="$1" '$1 != k && $2 != k' "$tabs" > "$tabs.tmp" && mv "$tabs.tmp" "$tabs"
}

next_n() {  # the nth tab this fake created; the first is 9, so w1:t9 and w1:p9 stay stable
  local n=9
  [ -n "$tabs" ] || { echo "$n"; return 0; }
  [ -f "$tabs.seq" ] && n="$(cat "$tabs.seq")"
  echo $((n + 1)) > "$tabs.seq"
  echo "$n"
}

listing() {  # $1 tabs|panes; the JSON the real CLI returns for that listing
  local rows=/dev/null
  { [ -n "$tabs" ] && [ -f "$tabs" ]; } && rows="$tabs"
  jq -R -s --arg k "$1" '{ result: { ($k): [
      split("\n")[] | select(length > 0) | split(" ")
      | if $k == "tabs"
        then { tab_id: .[0], label: .[2], workspace_id: (.[0] | split(":")[0]) }
        else select(.[1] != "-")
             | { pane_id: .[1], tab_id: .[0], workspace_id: (.[0] | split(":")[0]) }
        end ] } }' < "$rows"
}

case "$1 ${2:-}" in
  "tab create")
    label=""
    while [ $# -gt 0 ]; do
      if [ "$1" = "--cwd" ] && [ -n "${FAKE_HERDR_LOG:-}" ]; then printf '%s' "${2:-}" > "$FAKE_HERDR_LOG.cwd"; fi
      [ "$1" = "--label" ] && label="${2:-}"
      shift
    done
    n="$(next_n)"
    if [ -n "${FAKE_HERDR_NO_PANE_ID:-}" ]; then
      remember "w1:t$n" - "$label"
      printf '{"result":{"tab":{"tab_id":"w1:t%s"}}}\n' "$n"; exit 0
    fi
    remember "w1:t$n" "w1:p$n" "$label"
    printf '{"result":{"tab":{"tab_id":"w1:t%s"},"root_pane":{"pane_id":"w1:p%s"}}}\n' "$n" "$n" ;;
  "tab list")
    [ -n "${FAKE_HERDR_LIST_FAIL:-}" ] && { echo '{"error":{"code":"list_failed"}}' >&2; exit 1; }
    [ -n "${FAKE_HERDR_LIST_JUNK:-}" ] && { echo '{"result":{}}'; exit 0; }
    listing tabs ;;
  "pane list")
    [ -n "${FAKE_HERDR_PANE_LIST_FAIL:-}" ] && { echo '{"error":{"code":"list_failed"}}' >&2; exit 1; }
    listing panes ;;
  "tab close")
    [ -n "${FAKE_HERDR_TAB_CLOSE_FAIL:-}" ] && { echo '{"error":{"code":"close_failed"}}' >&2; exit 1; }
    forget "$3"
    echo '{"result":{}}' ;;
  "pane get")
    [ -e "${FAKE_HERDR_GET_FAIL:-/nonexistent}" ] && { echo '{"error":{"code":"server_unreachable"}}' >&2; exit 1; }
    if [ -e "${FAKE_HERDR_DEAD:-/nonexistent}" ]; then
      echo '{"error":{"code":"pane_not_found"}}' >&2; exit 1
    fi
    [ -n "${FAKE_HERDR_BAD_JSON:-}" ] && { echo '{"result":{}}'; exit 0; }
    focused=false; [ -e "${FAKE_HERDR_FOCUSED:-/nonexistent}" ] && focused=true
    echo "{\"result\":{\"pane\":{\"pane_id\":\"$3\",\"focused\":$focused}}}" ;;
  "pane close")
    [ -n "${FAKE_HERDR_CLOSE_FAIL:-}" ] && { echo '{"error":{"code":"close_failed"}}' >&2; exit 1; }
    forget "$3"
    echo '{"result":{}}' ;;
  "pane wait-output")
    [ -n "${FAKE_HERDR_NO_PROMPT:-}" ] && { echo '{"error":{"code":"timeout"}}' >&2; exit 1; }
    # The real pane matches the caller's regex against what the shell has drawn.
    # Matching it here too is what puts the adapter's prompt pattern under test:
    # FAKE_HERDR_PROMPT stands in for the operator's own prompt.
    re=""; while [ $# -gt 0 ]; do [ "$1" = "--regex" ] && re="$2"; shift; done
    if [ -n "$re" ] && ! printf '%s' "${FAKE_HERDR_PROMPT:-bash-3.2$ }" | grep -E "$re" >/dev/null; then
      echo '{"error":{"code":"timeout"}}' >&2; exit 1
    fi
    echo '{"result":{}}' ;;
  "pane run")
    # A test's own command, run at the moment the container takes the worker's
    # command, so it can see the state the rest of Dux is in right then.
    [ -z "${FAKE_HERDR_RUN_HOOK:-}" ] || bash -c "$FAKE_HERDR_RUN_HOOK"
    [ -n "${FAKE_HERDR_RUN_FAIL:-}" ] && { echo '{"error":{"code":"run_failed"}}' >&2; exit 1; }
    # The real pane types the text into whatever holds its terminal. When that
    # is the process an earlier run started in this same pane and it is still
    # alive, the text is input to it and not a new command, so it lands in the
    # file this fake stands in for a terminal with, one line per call. The
    # started process is told that file as FAKE_HERDR_INPUT.
    pid=""; [ -f "$procpid" ] && pid="$(cat "$procpid")"
    if [ -n "${FAKE_HERDR_RUN:-}" ] && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null &&
       [ "$(cat "$procpid.pane" 2>/dev/null)" = "$3" ]; then
      printf '%s\n' "$4" >> "$FAKE_HERDR_LOG.input"
      echo '{"result":{}}'; exit 0
    fi
    if [ -n "${FAKE_HERDR_RUN:-}" ]; then
      cwd="$(cat "${FAKE_HERDR_LOG:-/dev/null}.cwd")"
      printf '%s\n' "$3" > "$procpid.pane"
      # The real pane runs the command as a foreground job of its shell, in a
      # session of its own, and process-info reports the innermost of them. So
      # the fake puts it in a session of its own too (POSIX::setsid) and records
      # one pid for process-info to answer about, which has to end up being the
      # command's own, not a shell waiting on it. Hence bash and not /bin/sh:
      # measured 2026-09-15, bash replaces itself with the last command of a -c
      # line and Linux's /bin/sh (dash) forks and waits, so under /bin/sh the
      # recorded pid is the harness on macOS and a process named "sh" on Linux,
      # and every discovery on Linux times out. Bash starts asynchronous children
      # with INT ignored, so INT is reset before the exec to keep the signal
      # boundary faithful. Perl receives the literal $SIG, $$ and @ARGV names below.
      # Nothing but /dev/null on input and no inherited descriptor above 2: a
      # started process holding the suite's output pipe turns every failure in a
      # test that leaves one running into a hang instead of a red line.
      # shellcheck disable=SC2016
      ( cd "$cwd" || exit
        HERDR_PANE_ID="$3" HERDR_ENV=1 FAKE_HERDR_INPUT="$FAKE_HERDR_LOG.input" nohup perl -e '
          use POSIX; POSIX::setsid();
          $SIG{INT} = "DEFAULT";
          open(my $f, ">", $ARGV[0]) or die; print $f "$$\n"; close $f;
          exec("bash", "-c", $ARGV[1]);
        ' "$procpid" "$4" ) < /dev/null >> "${FAKE_HERDR_OUTPUT:-/dev/null}" 2>&1 \
        3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- &
    fi
    echo '{"result":{}}' ;;
  "pane process-info")
    # The real shape, measured 2026-09-14: the reply nests under
    # .result.process_info, foreground_processes is innermost first, and each
    # entry carries pid, argv0, cwd and the full cmdline. Every field about the
    # process is read from the system for the pid `pane run` recorded, never
    # written as a constant: a fixture argv0 would let the adapter's name check
    # pass against the fixture instead of against a real process.
    [ -n "${FAKE_HERDR_PROCINFO_FAIL:-}" ] && { echo '{"error":{"code":"server_unreachable"}}' >&2; exit 1; }
    [ -n "${FAKE_HERDR_PROCINFO_JUNK:-}" ] && { echo '{"result":{}}'; exit 0; }
    # A canned reply, for shapes no real process can produce on demand.
    [ -n "${FAKE_HERDR_PROCINFO_FILE:-}" ] && { cat "$FAKE_HERDR_PROCINFO_FILE"; exit 0; }
    pid=""; [ -f "$procpid" ] && pid="$(cat "$procpid")"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      comm="$(ps -o comm= -p "$pid" 2>/dev/null | sed 's/^ *//; s/ *$//')"
      argv0="${comm##*/}"
      cmdline="$(ps -ww -o command= -p "$pid" 2>/dev/null)"
      pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')"
      pcwd="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | tail -n 1)"
      [ -n "$pcwd" ] || pcwd="$(readlink "/proc/$pid/cwd" 2>/dev/null)"
      jq -nc --arg a "$argv0" --arg c "${pcwd:-}" --arg l "${cmdline:-}" \
        --argjson p "$pid" --argjson g "${pgid:-$pid}" \
        '{result:{process_info:{foreground_process_group_id:$g,shell_pid:1,
           foreground_processes:[{pid:$p,argv0:$a,name:$a,cwd:$c,cmdline:$l}],
           pane_id:"w1:p9"},type:"pane_process_info"}}'
    else
      jq -nc '{result:{process_info:{foreground_process_group_id:0,shell_pid:1,
                foreground_processes:[],pane_id:"w1:p9"},type:"pane_process_info"}}'
    fi ;;
  "pane report-metadata")
    # --source is required by the real CLI, which exits non-zero without it.
    case " $* " in *" --source "*) ;; *) echo "fake herdr: report-metadata needs --source" >&2; exit 2 ;; esac
    [ -n "${FAKE_HERDR_SLOW_METADATA:-}" ] && sleep "$FAKE_HERDR_SLOW_METADATA"
    echo '{"result":{}}' ;;
  "notification show")
    echo '{"result":{}}' ;;
  "status ")
    printf 'server:\n  status: running\n' ;;
  *)
    echo "fake herdr: unhandled: $*" >&2; exit 2 ;;
esac
