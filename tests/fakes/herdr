#!/usr/bin/env bash
# Fake herdr CLI for tests. Records calls; returns canned JSON.
# Live tabs live in $FAKE_HERDR_LOG.tabs, one "<tab_id> <pane_id|-> <label>" per
# line, so tab list and pane list answer for the tabs this fake actually holds.
set -u
printf '%s\n' "$*" >> "${FAKE_HERDR_LOG:-/dev/null}"
tabs=""; [ -n "${FAKE_HERDR_LOG:-}" ] && tabs="$FAKE_HERDR_LOG.tabs"

remember() {  # $1 tab_id, $2 pane_id or -, $3 label
  [ -n "$tabs" ] || return 0
  printf '%s %s %s\n' "$1" "$2" "$3" >> "$tabs"
}

forget() {  # $1 a tab id or a pane id; drops the row either names
  { [ -n "$tabs" ] && [ -f "$tabs" ]; } || return 0
  awk -v k="$1" '$1 != k && $2 != k' "$tabs" > "$tabs.tmp" && mv "$tabs.tmp" "$tabs"
}

next_n() {  # the nth tab this fake created; the first is 9, so w1:t9 and w1:p9 stay stable
  local n=9
  [ -n "$tabs" ] || { echo "$n"; return 0; }
  [ -f "$tabs.seq" ] && n="$(cat "$tabs.seq")"
  echo $((n + 1)) > "$tabs.seq"
  echo "$n"
}

listing() {  # $1 tabs|panes; the JSON the real CLI returns for that listing
  local rows=/dev/null
  { [ -n "$tabs" ] && [ -f "$tabs" ]; } && rows="$tabs"
  jq -R -s --arg k "$1" '{ result: { ($k): [
      split("\n")[] | select(length > 0) | split(" ")
      | if $k == "tabs"
        then { tab_id: .[0], label: .[2], workspace_id: (.[0] | split(":")[0]) }
        else select(.[1] != "-")
             | { pane_id: .[1], tab_id: .[0], workspace_id: (.[0] | split(":")[0]) }
        end ] } }' < "$rows"
}

case "$1 ${2:-}" in
  "tab create")
    label=""
    while [ $# -gt 0 ]; do
      if [ "$1" = "--cwd" ] && [ -n "${FAKE_HERDR_LOG:-}" ]; then printf '%s' "${2:-}" > "$FAKE_HERDR_LOG.cwd"; fi
      [ "$1" = "--label" ] && label="${2:-}"
      shift
    done
    n="$(next_n)"
    if [ -n "${FAKE_HERDR_NO_PANE_ID:-}" ]; then
      remember "w1:t$n" - "$label"
      printf '{"result":{"tab":{"tab_id":"w1:t%s"}}}\n' "$n"; exit 0
    fi
    remember "w1:t$n" "w1:p$n" "$label"
    printf '{"result":{"tab":{"tab_id":"w1:t%s"},"root_pane":{"pane_id":"w1:p%s"}}}\n' "$n" "$n" ;;
  "tab list")
    [ -n "${FAKE_HERDR_LIST_FAIL:-}" ] && { echo '{"error":{"code":"list_failed"}}' >&2; exit 1; }
    [ -n "${FAKE_HERDR_LIST_JUNK:-}" ] && { echo '{"result":{}}'; exit 0; }
    listing tabs ;;
  "pane list")
    [ -n "${FAKE_HERDR_PANE_LIST_FAIL:-}" ] && { echo '{"error":{"code":"list_failed"}}' >&2; exit 1; }
    listing panes ;;
  "tab close")
    [ -n "${FAKE_HERDR_TAB_CLOSE_FAIL:-}" ] && { echo '{"error":{"code":"close_failed"}}' >&2; exit 1; }
    forget "$3"
    echo '{"result":{}}' ;;
  "pane get")
    [ -e "${FAKE_HERDR_GET_FAIL:-/nonexistent}" ] && { echo '{"error":{"code":"server_unreachable"}}' >&2; exit 1; }
    if [ -e "${FAKE_HERDR_DEAD:-/nonexistent}" ]; then
      echo '{"error":{"code":"pane_not_found"}}' >&2; exit 1
    fi
    [ -n "${FAKE_HERDR_BAD_JSON:-}" ] && { echo '{"result":{}}'; exit 0; }
    focused=false; [ -e "${FAKE_HERDR_FOCUSED:-/nonexistent}" ] && focused=true
    echo "{\"result\":{\"pane\":{\"pane_id\":\"$3\",\"focused\":$focused}}}" ;;
  "pane read")
    n=120; while [ $# -gt 0 ]; do [ "$1" = "--lines" ] && n="$2"; shift; done
    tail -n "$n" "${FAKE_HERDR_OUTPUT:-/dev/null}" ;;
  "pane close")
    [ -n "${FAKE_HERDR_CLOSE_FAIL:-}" ] && { echo '{"error":{"code":"close_failed"}}' >&2; exit 1; }
    forget "$3"
    echo '{"result":{}}' ;;
  "pane wait-output")
    [ -n "${FAKE_HERDR_NO_PROMPT:-}" ] && { echo '{"error":{"code":"timeout"}}' >&2; exit 1; }
    # The real pane matches the caller's regex against what the shell has drawn.
    # Matching it here too is what puts the adapter's prompt pattern under test:
    # FAKE_HERDR_PROMPT stands in for the operator's own prompt.
    re=""; while [ $# -gt 0 ]; do [ "$1" = "--regex" ] && re="$2"; shift; done
    if [ -n "$re" ] && ! printf '%s' "${FAKE_HERDR_PROMPT:-bash-3.2$ }" | grep -E "$re" >/dev/null; then
      echo '{"error":{"code":"timeout"}}' >&2; exit 1
    fi
    echo '{"result":{}}' ;;
  "pane run")
    # A test's own command, run at the moment the container takes the worker's
    # command, so it can see the state the rest of Dux is in right then.
    [ -z "${FAKE_HERDR_RUN_HOOK:-}" ] || bash -c "$FAKE_HERDR_RUN_HOOK"
    [ -n "${FAKE_HERDR_RUN_FAIL:-}" ] && { echo '{"error":{"code":"run_failed"}}' >&2; exit 1; }
    if [ -n "${FAKE_HERDR_RUN:-}" ]; then
      cwd="$(cat "${FAKE_HERDR_LOG:-/dev/null}.cwd")"
      # Bash starts asynchronous children with INT ignored. The real pane runs
      # its command in the foreground, so reset INT in a tiny external launcher
      # before exec to keep this fake faithful to the real signal boundary.
      # Perl receives the literal $SIG and @ARGV names below.
      # shellcheck disable=SC2016
      ( cd "$cwd" || exit; HERDR_PANE_ID="$3" HERDR_ENV=1 nohup perl -e '$SIG{INT} = "DEFAULT"; exec @ARGV' bash -c "$4" >> "${FAKE_HERDR_OUTPUT:-/dev/null}" 2>&1 ) &
    fi
    echo '{"result":{}}' ;;
  "pane report-metadata")
    [ -n "${FAKE_HERDR_SLOW_METADATA:-}" ] && sleep "$FAKE_HERDR_SLOW_METADATA"
    echo '{"result":{}}' ;;
  "pane report-agent"|"notification show")
    echo '{"result":{}}' ;;
  "status ")
    printf 'server:\n  status: running\n' ;;
  *)
    echo "fake herdr: unhandled: $*" >&2; exit 2 ;;
esac
