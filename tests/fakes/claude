#!/usr/bin/env bash
# Fake worker harness for tests (claude, and codex via symlink). Ignores real
# flags; replays $FAKE_WORKER_SCRIPT (else $FAKE_CLAUDE_SCRIPT).
set -u
me="$(basename "$0")"
printf '%s %s\n' "$me" "$*" >> "${FAKE_WORKER_LOG:-/dev/null}"
script="${FAKE_WORKER_SCRIPT:-${FAKE_CLAUDE_SCRIPT:-}}"
log="${DUX_STATUS_LOG:-/dev/null}"
child=""; f=""; i=0
trap 'kill "$child" 2>/dev/null; exit 130' INT
trap 'kill "$child" 2>/dev/null; exit 143' TERM
if [ -z "$script" ] || [ ! -f "$script" ]; then echo '{"type":"result","subtype":"success"}'; exit 0; fi
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    status\ *)   printf '%s\n' "${line#status }" >> "$log"
                 printf '{"type":"assistant","text":%s}\n' "$(printf '%s' "${line#status }" | jq -Rs .)" ;;
    sleep\ *)    sleep "${line#sleep }" & child=$!; wait "$child"; child="" ;;
    dump-env\ *) env > "${line#dump-env }" ;;
    run\ *)      bash -c "${line#run }" ;;
    touch\ *)    f="${line#touch }"
                 # A bare name is the harness's own channel, which is where the
                 # real beat hooks write. The fake is told the channel through
                 # DUX_STATUS_LOG, the same way a worker is.
                 case "$f" in /*) ;; *) f="$(dirname "$log")/$f" ;; esac
                 touch "$f" ;;
    orphan\ *)   sleep 30 & echo $! > "${line#orphan }" ;;
    # HUP as well as TERM: a worker runs in a pane now, and the kernel hangs up
    # the whole foreground group when the session leader exits. A child that
    # only ignored TERM would be gone before the wrapper's stop began, which is
    # not the case the survivor guard is about. The child writes its own pid
    # once its traps are installed, and the harness waits for that, because a
    # harness that exited first would hang up a child still starting.
    stubborn\ *) f="${line#stubborn }"
                 # shellcheck disable=SC2016
                 bash -c 'trap "" TERM HUP; echo $$ > "$1"; while :; do sleep 1; done' _ "$f" &
                 i=0
                 while [ ! -s "$f" ] && [ "$i" -lt 100 ]; do i=$((i + 1)); sleep 0.1; done ;;
    report\ *)   printf '%s\n' "${line#report }" >> "${DUX_REPORT:-/dev/null}" ;;
    say\ *)      printf '{"type":"assistant","text":%s}\n' "$(printf '%s' "${line#say }" | jq -Rs .)" ;;
    exit\ *)     exit "${line#exit }" ;;
    *)           echo "fake $me: bad directive: $line" >&2; exit 99 ;;
  esac
done < "$script"
echo '{"type":"result","subtype":"success"}'
