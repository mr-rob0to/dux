#!/usr/bin/env bash
# Answers what /ship needs to know about the Dux checkout it was installed
# from: the step 6 reviewer and the step 7 reviewer. Called by SKILL.md; see
# spec section 11, change 9, and section 18.
#
# It lives beside SKILL.md for the reasons ship-guard does: dux-install
# symlinks the skill directory and the helper travels with it, and /ship runs
# inside a project worktree that knows nothing about DUX_HOME. So it sources
# nothing and carries its own finding(); the plan's header records that
# deviation from constitution principle 2.
#
# Unlike ship-guard, this one cannot work from a copy. Everything it answers
# lives in the checkout, so a skill copied somewhere else stops the gate rather
# than answering from nowhere.
set -u

finding() { printf 'finding: %s\n' "$*" >&2; exit 2; }

usage="usage: ship-env reviewer | security-reviewer | pr-template <repo> | pr-template-fallback | --root"

# pwd -P resolves dux-install's directory symlink, so the checkout is the one
# the skill was installed from and not wherever the link sits.
here="$(cd "$(dirname "$0")" && pwd -P)" || finding "cannot resolve the directory ship-env runs from"
root="${here%/*/*}"
[ -d "$root/templates/config" ] \
  || finding "ship-env is not inside a Dux checkout: $root/templates/config is not a directory"

# A note line and a blank line are skipped; the first line that is neither is
# the value. Returns 1 when the file holds no value, so the caller can fall back.
first_value() {  # $1 file
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in '#'* | '') continue ;; esac
    printf '%s\n' "$line"
    return 0
  done < "$1"
  return 1
}

# Both reviewers are commands, and which command a host can run is not a
# property of this repository. `auto`, the value both bundled defaults hold,
# means choose here, on every run, from what this host has. Nothing is written
# down: a machine that installs codex a week from now starts using it with no
# edit anywhere, and one that loses it stops naming a command that is not there.
# Deciding once, when the installer runs, is the shape of defect this repo has
# fixed before.
#
# The choice is not a silent one. It is only ever made where nobody has stated a
# preference, an explicit value is never probed, `ship-env reviewer` prints what
# was chosen before the gate runs, and step 6 makes the pull request name the
# reviewer that actually ran.
have() { command -v "$1" >/dev/null 2>&1; }

# The operator's own agent directory, and only that one. Claude Code also reads
# agent definitions out of the project it runs in, and the project here is the
# repository whose diff is being audited: a branch that commits
# .claude/agents/security-reviewer.md would be choosing, and writing, the auditor
# that reads it. Workers are untrusted by construction, so that file is exactly
# what a worker would add to have its own change waved through.
#
# A plugin can supply an agent as well, and no shell can see that, so this
# answers no on a host where the answer is yes. So can a project that has a real
# reason for its own reviewer. The cure for both is one line in
# config/security-reviewer, which belongs to the operator and is never probed.
agent_defined() {  # $1 name
  [ -f "${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}/agents/$1.md" ]
}

# Fable at high effort in plan mode, with the two tools that fetch a url taken
# away. Be plain about what that buys and what it does not. Plan mode is a
# permission rule, not the operating-system sandbox the codex line runs under:
# it means the session reads the tree and the diff and does not change them.
# Dropping WebFetch and WebSearch closes the two obvious ways out, and a review
# has no use for either. It does not put the session offline: the reviewer needs
# a shell to read a diff at all, and a shell can reach the network. Sealing that
# would mean taking the shell away, which leaves nothing that can review. The
# codex line is the one with a real sandbox; this is the fallback for a host
# that does not have it.
#
# --disallowedTools takes a list and keeps taking words until the next flag, so
# it cannot be last: the prompt the gate appends as one argument would be eaten
# as three more tool names and the run would end asking for a prompt. Every flag
# that takes a list goes before one that does not.
claude_reviewer='claude -p --disallowedTools WebFetch,WebSearch --model claude-fable-5-1 --effort high --permission-mode plan'

probe() {  # $1 key; prints the command this host can actually run
  case "$1" in
    reviewer)
      if have codex; then printf 'codex exec -m gpt-5.6-sol --sandbox read-only\n'
      elif have claude; then printf '%s\n' "$claude_reviewer"
      else finding "no code reviewer on this host: neither codex nor claude is on PATH; put a command line in $root/config/reviewer"
      fi ;;
    security-reviewer)
      if agent_defined security-reviewer; then printf 'agent:security-reviewer\n'
      elif have claude; then printf '%s\n' "$claude_reviewer"
      else finding "no security reviewer on this host: no security-reviewer agent definition and no claude on PATH; put a command line in $root/config/security-reviewer"
      fi ;;
    *) finding "nothing to probe for $1" ;;
  esac
}

# config/ is what the operator edits; templates/config/ is what ships. Reading
# both is what lets a fresh clone run the gate before the installer has run.
# A file holding `auto` states no preference, so the host is asked instead. A
# file holding nothing states nothing either and falls through to the next one,
# as it always did; only when neither file holds a value is it a finding.
value() {  # $1 key
  local f v
  for f in "$root/config/$1" "$root/templates/config/$1"; do
    [ -f "$f" ] || continue
    v="$(first_value "$f")" || continue
    if [ "$v" = auto ]; then probe "$1"; else printf '%s\n' "$v"; fi
    return 0
  done
  finding "no value for $1 in $root/config/$1 or $root/templates/config/$1"
}

# The lookup is not copied here. bin/dux-project owns it and is reachable,
# because the checkout is resolved before anything is answered. Empty output
# means the repo has no template; a delegate that failed must never be read as
# one, so a non-zero exit is a finding and nothing is printed.
pr_template() {  # $1 repo path
  local out
  out="$("$root/bin/dux-project" pr-template "$1")" \
    || finding "dux-project pr-template failed for $1"
  [ "$out" = none ] || printf '%s\n' "$out"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  '') finding "$usage" ;;
  --root)
    [ $# -eq 0 ] || finding "$usage"
    printf '%s\n' "$root" ;;
  reviewer | security-reviewer)
    [ $# -eq 0 ] || finding "$usage"
    value "$cmd" ;;
  pr-template)
    [ $# -eq 1 ] || finding "$usage"
    pr_template "$1" ;;
  pr-template-fallback)
    [ $# -eq 0 ] || finding "$usage"
    [ -f "$root/templates/PULL_REQUEST_TEMPLATE.md" ] \
      || finding "no bundled pull request template at $root/templates/PULL_REQUEST_TEMPLATE.md"
    printf '%s\n' "$root/templates/PULL_REQUEST_TEMPLATE.md" ;;
  *) finding "unknown key '$cmd' (reviewer, security-reviewer)" ;;
esac
exit 0
