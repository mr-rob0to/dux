#!/usr/bin/env bash
# Fleet digest from local files. Network access is opt-in through --prs and --intake.
set -u
# shellcheck source=bin/dux-env
source "$(dirname "${BASH_SOURCE[0]}")/dux-env"

ledger="$DUX_ROOT/bin/dux-ledger"
projects="$DUX_ROOT/bin/dux-project"
usage="usage: dux-status [--prs] [--intake]"
prs=0
intake=0
long_after="${DUX_LONG_RUNNING_SECS:-14400}"

while [ $# -gt 0 ]; do
  case "$1" in
    --prs) prs=1 ;;
    --intake) intake=1 ;;
    *) finding "$usage" ;;
  esac
  shift
done
# Before the digest, so the queue the digest counts is the queue the forge holds.
# One project's failure is one line: a misconfigured project must not hide the
# fleet, so the finding is reported and the loop carries on (spec section 14).
if [ "$intake" = 1 ]; then
  echo intake
  any=0
  for project in $("$projects" list); do
    case "$("$projects" get "$project" issues)" in label:?*) ;; *) continue ;; esac
    any=1
    if out="$("$DUX_ROOT/bin/dux-intake" "$project" 2>&1)"; then
      printf '%s\n' "$out" | sed 's/^/  /'
    else
      # What intake managed before it stopped is shown too: those tasks exist.
      [ -z "$out" ] || printf '%s\n' "$out" | grep -v -E '^(finding|dux): ' | sed 's/^/  /'
      # take_line ends the pipeline, and it succeeds whether or not grep matched,
      # so the fallback is chosen on the text rather than on an exit status.
      why="$(printf '%s\n' "$out" | grep -E '^(finding|dux): ' | take_line)"
      [ -n "$why" ] || why='intake failed'
      echo "  $project: skipped: $why"
    fi
  done
  [ "$any" = 1 ] || echo "  no project has issues enabled"
fi

w="$(cat "$DUX_STATE/watch.pid" 2>/dev/null)"
if pid_runs "$w" dux-watch; then echo "watcher: running (pid $w)"; else echo "watcher: not running"; fi
if [ -f "$DUX_STATE/dux.lock" ] && [ -f "$DUX_STATE/wakes.base" ]; then
  base="$(tr -d ' ' < "$DUX_STATE/wakes.base")"
  case "$base" in ''|*[!0-9]*) base=0 ;; esac
  total=0
  [ ! -f "$DUX_STATE/events.log" ] || total="$(wc -l < "$DUX_STATE/events.log" | tr -d ' ')"
  echo "wakes this session: $((total - base)) (restart after 10)"
fi

pr_state() {  # $1 URL
  local state
  if state="$(gh pr view "$1" --json state -q .state 2>/dev/null)" && [ -n "$state" ]; then
    echo "$state"
  else
    log "gh pr view failed for $1"
    echo "(pr state unavailable)"
  fi
}

is_long_running() {  # $1 id; the spawn-written brief is the age anchor
  local brief mtime age
  brief="$DUX_TASKS/$1/brief.md"
  [ -f "$brief" ] || return 1
  mtime="$(mtime_epoch "$brief" 2>/dev/null)" || return 1
  age=$(( $(date +%s) - mtime ))
  [ "$age" -ge "$long_after" ]
}

for project in $("$projects" list); do
  queued=0; running=0; stale=0; long=0; awaiting=0; recovery=0; ready=0; failed=0; ready_urls=""
  for id in $("$ledger" list --project "$project"); do
    state="$("$ledger" get "$id" state)"
    endpoint="$("$ledger" get "$id" endpoint)"
    pr="$("$ledger" get "$id" pr)"
    # The ledger is the whole picture. A status log that looks finished is a
    # worker talking about itself, and until a handoff proves it the task is
    # still running; counting it as anything else would put a worker's own
    # ending, and its own url, in the operator's digest.
    case "$state" in
      queued) queued=$((queued + 1)) ;;
      running) running=$((running + 1)); is_long_running "$id" && long=$((long + 1)) ;;
      stale) running=$((running + 1)); stale=$((stale + 1)); is_long_running "$id" && long=$((long + 1)) ;;
      needs-decision|blocked) awaiting=$((awaiting + 1)) ;;
      dead|ended) recovery=$((recovery + 1)) ;;
      done)
        if [ "$endpoint" != - ]; then
          ready=$((ready + 1))
          [ "$pr" = - ] || ready_urls="$ready_urls $pr"
        fi ;;
      failed) [ "$endpoint" = - ] || failed=$((failed + 1)) ;;
    esac
  done
  echo "$project"
  [ "$queued" = 0 ] || echo "  queued $queued"
  if [ "$running" != 0 ]; then
    suffix=""
    [ "$stale" = 0 ] || suffix="$stale stale"
    if [ "$long" != 0 ]; then
      [ -z "$suffix" ] || suffix="$suffix, "
      suffix="${suffix}${long} long-running"
    fi
    if [ -z "$suffix" ]; then echo "  running $running"; else echo "  running $running ($suffix)"; fi
  fi
  [ "$awaiting" = 0 ] || echo "  awaiting you $awaiting"
  [ "$recovery" = 0 ] || echo "  needs recovery $recovery"
  if [ "$ready" != 0 ]; then
    echo "  ready $ready"
    if [ "$prs" = 1 ]; then
      for url in $ready_urls; do echo "    $url $(pr_state "$url")"; done
    fi
  fi
  [ "$failed" = 0 ] || echo "  failed $failed"
done

unacked="$("$ledger" list --unacked)"
if [ -n "$unacked" ]; then
  echo unacknowledged
  for id in $unacked; do
    echo "  $("$ledger" get "$id" state): $id ($("$ledger" get "$id" project))"
  done
fi
