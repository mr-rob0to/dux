#!/usr/bin/env bash
# Spawn a queued task into a worktree and a backend container. Spec section 5.5.
set -u
# shellcheck source=bin/dux-env
source "$(dirname "${BASH_SOURCE[0]}")/dux-env"

usage="usage: dux-spawn <id> [--harness claude]"
id="${1:-}"; [ -n "$id" ] || die "$usage"
valid_task_id "$id"
shift
harness=""
while [ $# -gt 0 ]; do
  case "$1" in
    --harness) harness="$2"; shift 2 ;;
    *) die "$usage" ;;
  esac
done

task="$DUX_TASKS/$id"; brief="$task/brief.md"; epfile="$DUX_STATE/$id.endpoint"; branch="dux/$id"
pidfile="$DUX_STATE/$id.pid"
ledger="$DUX_ROOT/bin/dux-ledger"; worktree="$DUX_ROOT/bin/dux-worktree"; backend="$DUX_ROOT/bin/dux-backend"
placeholder='- Worktree: <set by dux-spawn>'

"$DUX_ROOT/bin/dux-lock" mine || finding "the Dux lock is not held by this session; refusing to spawn"
state="$("$ledger" get "$id" state)" || exit $?
[ "$state" = queued ] || finding "task $id is $state, not queued"
project="$("$ledger" get "$id" project)" || exit $?
source_key="$("$ledger" get "$id" source)" || exit $?
project_path="$("$DUX_ROOT/bin/dux-project" get "$project" path)" || exit $?
[ -s "$brief" ] || finding "no brief for $id; run dux-brief first"
# Any worktree line will do: a spawn killed after the line was filled must not need
# the operator to put the placeholder back, and the line is not what keeps a second
# worker off this task. The live container is (below).
grep -q '^- Worktree: ' "$brief" || finding "brief for $id has no worktree line to fill"
# The flag is the operator's choice and overwrites the task file below, so it is
# what gets checked when it is given; otherwise the task file, then the config.
chosen="$harness"; [ -n "$chosen" ] || chosen="$(task_harness "$task")"
why="$(harness_refusal "$chosen")" || finding "$why"
"$backend" name >/dev/null || exit $?
[ ! -e "$epfile" ] || finding "endpoint already recorded for $id in $epfile"
# Two signals, two questions, and either one that cannot say "gone" is a refusal.
# The pidfile is written by the wrapper itself, inside the container, on every
# backend, so it survives a Dux restarted under the other backend and a container
# a human renamed, both of which make `find` answer "none" about a worker that is
# running. No pidfile is the only reading that means no worker: one that cannot
# be read and one that does not hold a pid are both "could not tell". A recycled
# pid refuses a spawn that could have gone ahead, which costs one rescue against
# two agents on one branch. Teardown clears the file, so recovery is ordinary.
if [ -e "$pidfile" ] || [ -L "$pidfile" ]; then
  wpid="$(cat "$pidfile" 2>/dev/null)" \
    || finding "cannot read $pidfile; cannot tell whether a worker for $id is alive"
  case "$wpid" in
    ''|*[!0-9]*) finding "$pidfile does not hold a pid ('$(cap_line "$wpid")'); cannot tell whether a worker for $id is alive" ;;
    *) kill -0 "$wpid" 2>/dev/null \
         && finding "worker pid $wpid for $id is still running; tear the task down before spawning it again" ;;
  esac
fi
# Both backends name the container after the task, so whether a worker may still
# be alive is observable there too. Ask the backend as well as the pidfile.
alive_at="$("$backend" find "$id")" || exit $?
[ -z "$alive_at" ] || finding "a container for $id already exists at $alive_at; close it or tear the task down before spawning it again"

# One Dux-managed worker at a time. Several long workers spend one subscription
# between them, and the cheapest fix that actually works is to start the second
# one later. This is a refusal and not a queue: no scheduler, no reservation, no
# timer, no automatic start, and nothing to go wrong while nobody is watching.
# The operator runs the same command again once the active task has stopped.
#
# Two signals, the ones Dux already keeps, read for every other registered task.
#
# The pidfile, for any task at all: the wrapper writes it and teardown clears
# it, so a file naming a live process is the strongest evidence there is. It is
# matched against the command line as well, the way dux-recover matches it,
# because a pid the system handed to something else entirely would otherwise
# stop the whole fleet rather than one task. A file that cannot be read, or that
# holds something that is not a pid, blocks: Dux cannot prove the slot is free,
# and guessing free is the one answer that puts two agents on one account.
#
# The container, only for a task Dux still records as running or stale. Both
# backends keep the pane after the command in it exits, so a finished task that
# has not been torn down still has one; reading that as a live worker would
# refuse every spawn until the operator tidied up. Where Dux does believe a
# worker is at work, a pane it can see is evidence and a stuck run blocks the
# next start by design -- the refusal names it, and existing recovery clears it.
another_worker() {  # prints "<why> <id>" for a task whose worker may be alive
  local other opid opgid wpid g state at ids
  # The roster is read here, on its own line, and not as a command substitution
  # in the loop's here-document: a here-document throws the substitution's exit
  # status away, so a ledger that could not enumerate would read as an empty
  # fleet and let the start straight through. Same rule as below, one step
  # earlier.
  if ! ids="$("$ledger" list 2>/dev/null)"; then printf 'roster -'; return 0; fi
  while IFS= read -r other; do
    [ -n "$other" ] || continue
    [ "$other" = "$id" ] && continue
    opid="$DUX_STATE/$other.pid"
    if [ -e "$opid" ] || [ -L "$opid" ]; then
      wpid="$(cat "$opid" 2>/dev/null)" || { printf 'pidfile %s' "$other"; return 0; }
      case "$wpid" in
        ''|*[!0-9]*) printf 'pidfile %s' "$other"; return 0 ;;
        *) if pid_runs "$wpid" "dux-worker-wrap $other"; then printf 'live %s' "$other"; return 0; fi ;;
      esac
    fi
    # The harness's own group, which outlives its wrapper. A worker sits in a
    # live session now, so a wrapper killed while the session is still at its
    # prompt leaves a pidfile that reads gone and a tab full of agent. Reading
    # only the pidfile would let a second worker start beside it. The pgid file
    # is written once the group is known and cleared at teardown, and its
    # unreadable forms fail closed exactly as the pidfile's do.
    opgid="$DUX_STATE/$other.pgid"
    if [ -e "$opgid" ] || [ -L "$opgid" ]; then
      g="$(cat "$opgid" 2>/dev/null)" || { printf 'pgidfile %s' "$other"; return 0; }
      case "$g" in
        ''|*[!0-9]*) printf 'pgidfile %s' "$other"; return 0 ;;
        *) if kill -0 -- "-$g" 2>/dev/null; then printf 'live %s' "$other"; return 0; fi ;;
      esac
    fi
    # Fail closed, the same way the pidfile does. A ledger or a backend that
    # will not answer about another task is "could not tell", not "free", and
    # answering "free" on no evidence is what puts two agents on one account.
    # The refusal names which of the two went quiet, because they are fixed
    # differently: one is the backlog, the other is the container runner.
    if ! state="$("$ledger" get "$other" state 2>/dev/null)"; then
      printf 'ledger %s' "$other"; return 0
    fi
    case "$state" in
      running|stale)
        if ! at="$("$backend" find "$other" 2>/dev/null)"; then
          printf 'backend %s' "$other"; return 0
        fi
        [ -z "$at" ] || { printf 'live %s' "$other"; return 0; } ;;
    esac
  done <<EOF
$ids
EOF
  return 1
}
if busy="$(another_worker)"; then
  other="${busy#* }"
  case "${busy%% *}" in
    roster)  finding "cannot tell whether another Dux worker is alive: the ledger could not list the tasks; $id remains queued" ;;
    live)    finding "another Dux worker is active: $other; $id remains queued" ;;
    pidfile) finding "cannot tell whether a worker for $other is alive: $DUX_STATE/$other.pid does not say; $id remains queued" ;;
    # Its own wording because it is its own file: an operator told to look at
    # the pidfile would find a perfectly good one and no fault to fix.
    pgidfile) finding "cannot tell whether a worker for $other is alive: $DUX_STATE/$other.pgid does not say; $id remains queued" ;;
    ledger)  finding "cannot tell whether a worker for $other is alive: the ledger did not answer; $id remains queued" ;;
    backend) finding "cannot tell whether a worker for $other is alive: the backend did not answer; $id remains queued" ;;
  esac
fi

if [ -n "$harness" ]; then echo "$harness" > "$task/harness" || finding "cannot write $task/harness"; fi

wt="$("$worktree" create "$id")" || exit $?

set_worktree_line() {  # $1: replaces the brief's first "- Worktree: " line
  awk -v to="$1" 'hit == 0 && index($0, "- Worktree: ") == 1 { print to; hit = 1; next } { print }' "$brief" > "$brief.tmp" \
    && mv "$brief.tmp" "$brief"
}
undo() {  # after a failed open. The brief line goes back either way, so no retry is
          # blocked by it; the worktree goes only when nothing is running in it.
  local alive
  alive="$("$backend" find "$id")" || exit $?
  set_worktree_line "$placeholder" || log "could not restore the worktree line in $brief"
  [ -z "$alive" ] || finding "backend open failed for $id but a container for it is alive at $alive; close it before spawning $id again"
  "$worktree" discard "$id" >/dev/null 2>&1 || log "worktree $wt left in place; run dux-worktree discard $id by hand"
}

# After the tab is open there is more to put back: the pane spawn opened, the
# endpoint file, and the ledger field. `undo` alone would leave a tab holding a
# shell and an endpoint pointing at it, and the next spawn refuses on both.
undo_open() {
  if [ -n "${ep:-}" ]; then
    "$backend" close "$ep" >/dev/null 2>&1 || log "could not close $ep; close it by hand before spawning $id again"
  fi
  rm -f "$epfile" || log "could not remove $epfile"
  "$ledger" set "$id" endpoint - || log "could not clear the endpoint of $id in the ledger"
  undo
}

if ! set_worktree_line "- Worktree: $wt"; then
  "$worktree" discard "$id" >/dev/null 2>&1 || true
  finding "cannot fill the worktree line in $brief"
fi
# An interactive claude in a directory it has not seen asks whether to trust the
# folder, and the cursor sits on "No, exit". Print mode never asked. A worker
# left at that dialog would pass discovery, never touch its beat file, and hold
# the one-worker slot until the stale wake twenty minutes later, on every
# unattended run. So the answer is read before the tab opens, out of the
# operator's own file, and never written: Claude Code rewrites that file from
# every live session, so a Dux write would race the operator's.
trusted_worktree() {  # $1 a path; 0 when it or an ancestor is trusted
  local conf p="$1"
  conf="${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"
  [ -s "$conf" ] || return 1
  while :; do
    jq -e --arg p "$p" '.projects[$p].hasTrustDialogAccepted == true' "$conf" >/dev/null 2>&1 && return 0
    case "$p" in /|.|'') return 1 ;; esac
    p="$(dirname "$p")"
  done
}
if ! trusted_worktree "$wt"; then
  undo
  finding "$project_path is not trusted by Claude Code; open a session in it once and answer \"Yes, I trust this folder\""
fi

# The tab opens as a shell at its prompt and holds the harness, not the wrapper.
ep="$("$backend" open "$id" "$wt")" || { rc=$?; undo; exit $rc; }

echo "$ep" > "$epfile" || { undo_open; finding "cannot write $epfile"; }
"$ledger" set "$id" endpoint "$ep" || { rc=$?; undo_open; exit "$rc"; }

# The wrapper supervises from outside the tab, so spawn starts it here: its own
# process group under set -m so a signal to Dux does not reach it, nohup so a
# closed terminal does not, stdin from /dev/null, its two streams appended to a
# log of Dux's own lines, and the task worktree as its directory. The subshell
# prints $! because a wrapper spawn cannot name is one it cannot stop.
wraplog="$DUX_STATE/$id.wrap.log"
seq_before="$(handoff_next_seq "$id")"
wpid="$(cd "$wt" && { set -m; nohup "$DUX_ROOT/bin/dux-worker-wrap" "$id" < /dev/null >> "$wraplog" 2>&1 & echo $!; })" \
  || { undo_open; finding "cannot start the wrapper for $id; see $wraplog"; }
case "$wpid" in ''|*[!0-9]*) undo_open; finding "the wrapper for $id did not report a pid; see $wraplog" ;; esac

# Three endings, first one wins: the wrapper writes its pidfile and is alive, so
# the task is running; the wrapper is gone, so it refused; or the window runs
# out with neither, which is a wrapper that is stuck before its pidfile and is
# stopped rather than left behind.
waited=0; live=0
while [ "$waited" -lt "${DUX_SPAWN_START_SECS:-10}" ]; do
  if pid_runs "$(cat "$pidfile" 2>/dev/null)" "dux-worker-wrap $id"; then live=1; break; fi
  kill -0 "$wpid" 2>/dev/null || break
  waited=$((waited + 1)); sleep 1
done
if [ "$live" = 0 ] && kill -0 "$wpid" 2>/dev/null; then
  kill -TERM "$wpid" 2>/dev/null || true
  waited=0
  while [ "$waited" -lt 10 ] && kill -0 "$wpid" 2>/dev/null; do waited=$((waited + 1)); sleep 1; done
fi
if [ "$live" = 0 ]; then
  # A refusal made after the wrapper opened its run record leaves a failed
  # handoff, which the watcher applies to a queued task. Touching anything here
  # would race that, and the worktree is what recovery reads. A refusal before
  # the run record leaves nothing at all, so spawn puts the task back as a
  # failed open is put back, and closes the tab it opened.
  if [ "$(handoff_next_seq "$id")" != "$seq_before" ]; then
    finding "the wrapper for $id refused before the harness started; see $wraplog"
  fi
  undo_open
  finding "the wrapper for $id did not start; see $wraplog"
fi

# From queued, and only from queued. The wrapper is running by now, and one that
# refuses leaves a proved terminal handoff the watcher can apply before this
# line runs. Writing running whatever the ledger holds would put a finished task
# back to running for good, and reading the state first would leave the same
# window open; the ledger compares and sets under its own lock instead, and a
# refusal is a finding naming the state that won.
"$ledger" set-if "$id" state queued running || exit $?
case "$source_key" in
  gh:*)
    ref="${source_key#gh:}"; slug="${ref%%#*}"; n="${ref##*#}"
    gh issue comment "$n" --repo "$slug" --body "Dux started on branch \`$branch\`." >/dev/null 2>&1 \
      || log "could not comment on $source_key; the task is running regardless" ;;
esac
echo "spawned $id endpoint=$ep worktree=$wt"
