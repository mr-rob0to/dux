#!/usr/bin/env bash
# Tear down a terminal task. Spec section 5.6.
set -u
# shellcheck source=bin/dux-env
source "$(dirname "${BASH_SOURCE[0]}")/dux-env"

usage="usage: dux-teardown [--abandon] <id>"
# Two verbs, one script. Plain teardown ends work that ran; --abandon lets go of
# work that never started. They are kept apart because the uncommitted-work and
# live-worker refusals below have nothing to refuse on a task with no worktree.
abandon=0
if [ "${1:-}" = --abandon ]; then abandon=1; shift; fi
id="${1:-}"; [ -n "$id" ] || die "$usage"
valid_task_id "$id"
epfile="$DUX_STATE/$id.endpoint"
pidfile="$DUX_STATE/$id.pid"; pgidfile="$DUX_STATE/$id.pgid"
ledger="$DUX_ROOT/bin/dux-ledger"; backend="$DUX_ROOT/bin/dux-backend"

is_terminal() { case "$1" in done|failed) return 0 ;; *) return 1 ;; esac; }

"$DUX_ROOT/bin/dux-lock" mine || finding "the Dux lock is not held by this session; refusing to tear down"

# ---- abandon -------------------------------------------------------------
# A task created and briefed, then superseded before it ever spawned, has no
# worktree, no branch and no pull request, and nothing here to protect. Same for
# one intake dropped when its issue closed, or recovery dropped when it could
# not render the retry's brief. Without this they stay in the digest for good.
#
# Never having run is proved from the filesystem, not the ledger: a spawn killed
# between the worktree and the state write leaves a live task still reading
# queued. The worktree is made first and cleared last, so it covers the whole of
# that window; the four state files cover a wrapper that got further.
if [ "$abandon" = 1 ]; then
  lstate="$("$ledger" get "$id" state)" || exit $?
  case "$lstate" in
    queued|dropped) ;;
    *) finding "task $id is $lstate, not queued or dropped; use bin/dux-teardown $id" ;;
  esac
  # -L as well as -e: a dangling symlink is a reference a run left too.
  for f in run pid pgid portal; do
    { [ ! -e "$DUX_STATE/$id.$f" ] && [ ! -L "$DUX_STATE/$id.$f" ]; } \
      || finding "task $id has a $f file at state/$id.$f, so it has run; use bin/dux-teardown $id"
  done
  wt="$("$DUX_ROOT/bin/dux-worktree" path "$id" 2>&1)"; rc=$?
  [ "$rc" -ne 0 ] || finding "task $id has a worktree at $(cap_line "$wt"), so it has run; use bin/dux-teardown $id"
  # Only one reading means no worktree. A project that is no longer registered,
  # a repository that is not a checkout, a git that printed something else: all
  # of those are "could not tell", and the folder about to be removed is where a
  # live wrapper appends its status log and its report.
  case "$wt" in
    "finding: no worktree on dux/$id in "*) ;;
    *) finding "cannot tell whether $id has a worktree: $(cap_line "$wt")" ;;
  esac
  # Compare and set, not set: the state was read at the top of this block and the
  # proof above takes time, so a spawn that got the task to running in between
  # must win. The ledger does the comparison under its own lock and refuses with
  # a finding naming the state that won, before anything is removed. This does
  # not close the window entirely: a spawn still between its worktree and its own
  # state write leaves the ledger reading queued, and abandon goes ahead. Nothing
  # of the worker's is lost when it does, because dux-worker-wrap refuses at once
  # on a missing task folder.
  #
  # The ledger first either way: a folder removal that fails leaves a dropped
  # task whose rerun still works, and a ledger write that fails leaves a queued
  # task whose folder is already gone, which reruns too.
  "$ledger" set-if "$id" state "$lstate" dropped || exit $?
  rm -rf "${DUX_TASKS:?}/$id" || finding "cannot remove $DUX_TASKS/$id; the ledger now reads dropped"
  echo "abandoned $id"
  exit 0
fi
# The ledger, and nothing else. A status log that reads done is a worker talking
# about itself; only a proved handoff the watcher applied puts a task here, and
# removing a worktree on anything less would throw away unproved work.
lstate="$("$ledger" get "$id" state)" || exit $?
# Both are read before anything is torn down: the endpoint is set to - below, and
# whether it was still set here is what tells a first teardown from a rerun.
src="$("$ledger" get "$id" source)" || exit $?
ep_before="$("$ledger" get "$id" endpoint)" || exit $?
is_terminal "$lstate" || finding "task $id is not terminal (ledger: $lstate)"
final="$lstate"
# Read the same file as strictly as dux-spawn does, or the two disagree about the
# same worker. No pidfile is the only reading that means no worker: one that
# cannot be read and one that does not hold a pid are both "could not tell", and
# tearing a worktree out from under a live worker is what that would cost.
if [ -e "$pidfile" ] || [ -L "$pidfile" ]; then
  wpid="$(cat "$pidfile" 2>/dev/null)" \
    || finding "cannot read $pidfile; cannot tell whether a worker for $id is alive"
  case "$wpid" in
    ''|*[!0-9]*) finding "$pidfile does not hold a pid ('$(cap_line "$wpid")'); cannot tell whether a worker for $id is alive" ;;
    *) if kill -0 "$wpid" 2>/dev/null; then finding "worker $wpid for $id is still running"; fi ;;
  esac
fi
# The wrapper's pid is not the worker. A wrapper that crashed leaves the worker's
# own processes running as their own group, and the folder they are working in is
# the worktree this is about to remove. Read the file exactly as recovery does:
# only "no file" and "the group is gone" mean no worker.
if [ -e "$pgidfile" ] || [ -L "$pgidfile" ]; then
  pg="$(cat "$pgidfile" 2>/dev/null)" \
    || finding "cannot read $pgidfile; cannot tell whether the worker's own processes for $id are gone"
  case "$pg" in
    ''|*[!0-9]*) finding "$pgidfile does not hold a process group ('$(cap_line "$pg")'); cannot tell whether the worker's own processes for $id are gone" ;;
    *) if kill -0 -- "-$pg" 2>/dev/null; then finding "the worker's own processes for $id are still running as group $pg"; fi ;;
  esac
fi

"$DUX_ROOT/bin/dux-worktree" remove "$id" || exit $?

if [ -f "$epfile" ]; then
  ep="$(cat "$epfile")"
  "$backend" exists "$ep"; rc=$?
  case "$rc" in
    0) "$backend" close "$ep" || exit $? ;;
    1) log "container $ep already gone" ;;
    *) exit "$rc" ;;
  esac
  rm -f "$epfile"
else
  log "no endpoint recorded for $id"
fi
rm -f "$pidfile"

# A run's references outlive the run on purpose: the handoff sequences so a
# restarted watcher can replay the one it was applying, the run record and the
# receipt so a late result can still be proved. Teardown owns their end.
rm -rf "$DUX_STATE/$id.handoffs"
rm -f "$DUX_STATE/$id.run" "$DUX_STATE/$id.result-context" "$DUX_STATE/$id.ship-receipt"
# A wrapper that reached its own ending cleared its task channel on the way out,
# and dead recovery clears one a crashed wrapper left as soon as the worker's own
# process group has gone. Neither ran here, so teardown is the last owner. The
# worker is proved gone above, and the worktree is already removed.
portal="$DUX_STATE/$id.portal"
clear_channel "$id" "$portal"
rm -f "$portal" "$pgidfile"

pr="$("$ledger" get "$id" pr)" || exit $?
"$ledger" set "$id" state "$final" || exit $?
"$ledger" set "$id" endpoint - || exit $?
# The issue hears once, from the first teardown that completes: a rerun reads
# endpoint=- and says nothing. A failed comment is a warning, as at spawn; the
# PR body's Closes #<n> links the issue from the moment the PR opened.
if [ "$final" = "done" ] && [ "$pr" != - ] && [ "$ep_before" != - ]; then
  case "$src" in
    gh:*)
      ref="${src#gh:}"; slug="${ref%%#*}"; n="${ref##*#}"
      # Only a PR in the issue's own repository. A url anywhere else is not this
      # issue's delivery, and posting it would point readers at another repo.
      case "${pr#https://github.com/"$slug"/pull/}" in
        ''|*[!0-9]*) log "PR $pr is not in $slug; no issue comment" ;;
        *) gh issue comment "$n" --repo "$slug" --body "Dux delivered PR $pr." >/dev/null 2>&1 \
             || log "could not comment on $src; the task is torn down regardless" ;;
      esac ;;
  esac
fi
echo "torn down $id state=$final pr=$pr"
