#!/usr/bin/env bash
# Formats one action-first line for a task event. See spec section 6.3.
set -u
# shellcheck source=bin/dux-env
source "$(dirname "${BASH_SOURCE[0]}")/dux-env"

usage="usage: dux-notify <id> [--toast]"
id="${1:-}"
[ -n "$id" ] || finding "$usage"
shift
toast=0
while [ $# -gt 0 ]; do
  case "$1" in --toast) toast=1 ;; *) finding "$usage" ;; esac
  shift
done
valid_task_id "$id"
ledger="$DUX_ROOT/bin/dux-ledger"

state="$("$ledger" get "$id" state)" || exit $?
project="$("$ledger" get "$id" project)" || exit $?
shape="$("$ledger" get "$id" shape)" || exit $?
pr="$("$ledger" get "$id" pr)" || exit $?

# Every word of this line comes from the ledger. Nothing a worker wrote is read
# here at all: a notification is a push with no way to mark where the worker's
# words start and end, so it says what to do and which task, and the operator
# reads the worker's own account through dux-recover, which fences it as data.
case "$state" in
  done)
    if [ "$pr" != - ]; then line="Review, then merge or send feedback: $pr ($project $shape)"
    else line="Read the report: $project $shape finished ($id)"; fi ;;
  needs-decision) line="Decide: $project $shape is waiting on an answer ($id)" ;;
  blocked) line="Unblock: $project $shape is blocked ($id)" ;;
  failed) line="Retry or drop: $project $shape failed ($id)" ;;
  stale) line="Check: $project $shape has been silent; recovery in progress ($id)" ;;
  dead) line="Check: $project $shape worker died; recovery in progress ($id)" ;;
  ended) line="Classify: $project $shape exited without a result ($id)" ;;
  *) finding "nothing to notify for $id (state $state)" ;;
esac
[ "${#line}" -le 200 ] || line="${line:0:197}..."
echo "$line"
[ "$toast" = 0 ] || "$DUX_ROOT/bin/dux-backend" notify Dux "$line" >/dev/null 2>&1 || true
