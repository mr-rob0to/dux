#!/usr/bin/env bash
# Symlink bundled skills into the user's skills dir; seed config. Spec section 18.
set -u
# shellcheck source=bin/dux-env
source "$(dirname "${BASH_SOURCE[0]}")/dux-env"

yes=0; [ "${1:-}" = "--yes" ] && yes=1
target="${DUX_SKILLS_DIR:-$HOME/.claude/skills}"
mkdir -p "$target" 2>/dev/null || finding "cannot create $target"

for d in "$DUX_ROOT"/skills/*/; do
  [ -d "$d" ] || continue
  n="$(basename "$d")"; dst="$target/$n"; src="$DUX_ROOT/skills/$n"
  if [ -L "$dst" ]; then
    [ "$(readlink "$dst")" = "$src" ] && { log "ok $n"; continue; }
    [ "$yes" = 1 ] || finding "$dst is a symlink to $(readlink "$dst"), not this repo; rerun with --yes to replace it"
    rm -f "$dst"
  elif [ -e "$dst" ]; then
    [ "$yes" = 1 ] || finding "$dst exists and is not a symlink; rerun with --yes to move it to $n.bak"
    if [ -e "$dst.bak" ] || [ -L "$dst.bak" ]; then finding "$dst.bak already exists; move it away before rerunning"; fi
    mv "$dst" "$dst.bak" 2>/dev/null || finding "cannot move $dst to $dst.bak"
    log "moved $dst to $dst.bak"
  fi
  ln -s "$src" "$dst" 2>/dev/null || finding "cannot link $dst"
  log "linked $n"
done

for f in "$DUX_ROOT"/templates/config/*; do
  [ -e "$f" ] || continue
  n="$(basename "$f")"
  if [ -e "$DUX_CONFIG/$n" ] || [ -L "$DUX_CONFIG/$n" ]; then continue; fi
  cp "$f" "$DUX_CONFIG/$n" 2>/dev/null || finding "cannot write $DUX_CONFIG/$n"
  log "config $n seeded"
done

# Two denylists, because they are matched differently by `make lint-identifiers`.
# Paths and project names are matched literally; a bare account name is matched
# only as a whole word, and the Makefile drops the generic account names outright.
#
# Dux is registered as a project of itself, and a project name is matched as a
# substring, so writing this repo's own name here made every tracked file match
# and turned the lint into noise. Whole-word matching does not help: a hyphen is
# a word boundary, so dux-install still matches dux. The project whose checkout
# is this repo is the one name that cannot mean anything inside it, so it is the
# one that is left out. Every other name is written, short ones included; the
# Makefile refuses a name too short to match safely, by name, which is a
# decision for the operator rather than one to make silently here.
mkdir -p "$DUX_ROOT/tests" 2>/dev/null || finding "cannot create $DUX_ROOT/tests"
root_real="$(cd "$DUX_ROOT" 2>/dev/null && pwd -P)" || root_real=""
skipped=""
if [ -f "$DUX_DATA/projects.md" ] && [ -n "$root_real" ]; then
  while read -r name path; do
    [ -n "$path" ] || continue
    p_real="$(cd "$path" 2>/dev/null && pwd -P)" || continue
    [ "$p_real" = "$root_real" ] || continue
    skipped="$name"
  done <<EOF
$(sed -n 's/^- \([^ ]*\) \([^ ]*\).*/\1 \2/p' "$DUX_DATA/projects.md")
EOF
fi
drop_self() {  # reads names, writes the ones that are not this repo's own
  if [ -n "$skipped" ]; then grep -vxF "$skipped"; else cat; fi
}
{
  echo "$HOME"
  [ -f "$DUX_DATA/projects.md" ] \
    && sed -n 's/^- \([^ ]*\) .*/\1/p' "$DUX_DATA/projects.md" | drop_self
} | grep -v '^$' | sort -u > "$DUX_ROOT/tests/personal-identifiers.txt"
{
  whoami; basename "$HOME"
} | grep -v '^$' | sort -u > "$DUX_ROOT/tests/personal-names.txt"
log "identifier denylist written"
[ -z "$skipped" ] || log "left this repo's own project out of the denylist: $skipped"
