#!/usr/bin/env bash
# Symlink bundled skills into the user's skills dir; seed config. Spec section 18.
set -u
# shellcheck source=bin/dux-env
source "$(dirname "${BASH_SOURCE[0]}")/dux-env"

yes=0; [ "${1:-}" = "--yes" ] && yes=1
target="${DUX_SKILLS_DIR:-$HOME/.claude/skills}"
mkdir -p "$target" 2>/dev/null || finding "cannot create $target"

for d in "$DUX_ROOT"/skills/*/; do
  [ -d "$d" ] || continue
  n="$(basename "$d")"; dst="$target/$n"; src="$DUX_ROOT/skills/$n"
  if [ -L "$dst" ]; then
    [ "$(readlink "$dst")" = "$src" ] && { log "ok $n"; continue; }
    [ "$yes" = 1 ] || finding "$dst is a symlink to $(readlink "$dst"), not this repo; rerun with --yes to replace it"
    rm -f "$dst"
  elif [ -e "$dst" ]; then
    [ "$yes" = 1 ] || finding "$dst exists and is not a symlink; rerun with --yes to move it to $n.bak"
    if [ -e "$dst.bak" ] || [ -L "$dst.bak" ]; then finding "$dst.bak already exists; move it away before rerunning"; fi
    mv "$dst" "$dst.bak" 2>/dev/null || finding "cannot move $dst to $dst.bak"
    log "moved $dst to $dst.bak"
  fi
  ln -s "$src" "$dst" 2>/dev/null || finding "cannot link $dst"
  log "linked $n"
done

# A model file is a list of <key>=<model>:<effort> words, and new keys arrive
# with new routing. An install that already has the file never gets them from
# the copy below, and a ship task whose key is missing refuses rather than
# guessing, so the keys the template names and the file does not are appended.
# Appended, never edited: every value already there is the operator's, including
# one they deliberately changed, and a newline separates entries as well as a
# space does. Anything that is not a plain readable file is left alone; a
# dangling link is somebody's arrangement, and a half-done install is worse
# than a missing key that names itself the first time a worker starts.
add_missing_keys() {  # $1 template, $2 existing file
  local want key added=""
  [ -f "$2" ] && [ -r "$2" ] || return 0
  while read -r want; do
    case "$want" in ''|'#'*) continue ;; esac
    key="${want%%=*}"
    [ "$key" != "$want" ] || continue
    tr '[:blank:]' '\n' < "$2" | sed -n 's/=.*//p' | grep -xF "$key" >/dev/null && continue
    added="$added $want"
  done <<EOF
$(tr '[:blank:]' '\n' < "$1")
EOF
  [ -n "$added" ] || return 0
  printf '%s\n' "${added# }" >> "$2" || finding "cannot add model keys to $2"
  log "config $(basename "$2"): added $(printf '%s' "${added# }" | tr ' ' '\n' | sed 's/=.*//' | tr '\n' ',' | sed 's/,$//; s/,/, /g')"
}

for f in "$DUX_ROOT"/templates/config/*; do
  [ -e "$f" ] || continue
  n="$(basename "$f")"
  if [ -e "$DUX_CONFIG/$n" ] || [ -L "$DUX_CONFIG/$n" ]; then
    case "$n" in models|models-*) add_missing_keys "$f" "$DUX_CONFIG/$n" ;; esac
    continue
  fi
  cp "$f" "$DUX_CONFIG/$n" 2>/dev/null || finding "cannot write $DUX_CONFIG/$n"
  log "config $n seeded"
done

# Two denylists, because they are matched differently by `make lint-identifiers`.
# Paths and project names are matched literally; a bare account name is matched
# only as a whole word, and the Makefile drops the generic account names outright.
#
# Two kinds of registered name are never written, each logged as it is left out.
# The lint has no length rule of its own: what is worth writing is decided here.
#
# First, the project whose repository is the checkout being installed into. Dux
# is registered as a project of itself, and its own name cannot leak into it: it
# is the repository's name, in the README and in every script. In the paths list,
# which is matched as a substring, it made every tracked file match; whole-word
# matching would not help, since a hyphen is a word boundary. The skip used to
# fire only when the name was already in the tracked content, which is exactly
# the case where a real leak gets hidden.
#
# "The checkout being installed into" is the repository, not the directory: the
# git directory a checkout and its worktrees share, so an install run from a
# worktree reaches the same answer. Comparing paths does not, and would write the
# name into the worktree, where the lint then matches every file. Not being in a
# repository, on either side, simply is not self.
#
# Second, a name shorter than four characters, which as a substring hits nearly
# every file. A log line and not a finding: the skills are linked and the config
# seeded by now, nothing on the machine is wrong, and stopping would strand a
# half-done install that fails at the same name on every rerun.
mkdir -p "$DUX_ROOT/tests" 2>/dev/null || finding "cannot create $DUX_ROOT/tests"
git_home() {  # $1 dir; prints the resolved git dir it shares with its worktrees
  local g
  g="$(cd "$1" 2>/dev/null && git rev-parse --git-common-dir 2>/dev/null)" || return 0
  [ -n "$g" ] || return 0
  ( cd "$1" && cd "$g" 2>/dev/null && pwd -P ) || return 0
}
root_git="$(git_home "$DUX_ROOT")"
skipped=""
if [ -f "$DUX_DATA/projects.md" ]; then
  while read -r name path; do
    [ -n "$name" ] || continue
    if [ -n "$path" ] && [ -n "$root_git" ] && [ "$(git_home "$path")" = "$root_git" ]; then
      skipped="$skipped$name
"
      log "left this repo's own project out of the denylist: $name"
      continue
    fi
    if [ "${#name}" -lt 4 ]; then
      skipped="$skipped$name
"
      log "left $name out of the denylist: shorter than four characters, and the lint would match nearly every file; register it under a longer name with dux-project add --name"
    fi
  done <<EOF
$(sed -n 's/^- \([^ ]*\) path=\([^ ]*\).*/\1 \2/p' "$DUX_DATA/projects.md")
EOF
fi
drop_skipped() {  # reads names, writes the ones that are not being left out
  # -f rather than an argument, because a project name may legitimately start
  # with a hyphen: handed to grep as an argument it is read as options, the
  # pipeline hides the error, and every other name disappears from the list.
  # The list is a here-document rather than a temporary file, so there is no
  # write that can fail half way and leave a name logged as skipped but written.
  if [ -n "$skipped" ]; then grep -vxF -f <(printf '%s' "$skipped"); else cat; fi
}
{
  echo "$HOME"
  [ -f "$DUX_DATA/projects.md" ] \
    && sed -n 's/^- \([^ ]*\) .*/\1/p' "$DUX_DATA/projects.md" | drop_skipped
} | grep -v '^$' | sort -u > "$DUX_ROOT/tests/personal-identifiers.txt"
{
  whoami; basename "$HOME"
} | grep -v '^$' | sort -u > "$DUX_ROOT/tests/personal-names.txt"
log "identifier denylist written"
