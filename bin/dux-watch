#!/usr/bin/env bash
# Turns worker state changes into events. A per-task surprise is logged and
# skipped so supervision of every other task continues. See spec section 6.1.
set -u
# shellcheck source=bin/dux-env
source "$(dirname "${BASH_SOURCE[0]}")/dux-env"

events="$DUX_STATE/events.log"
watchpid="$DUX_STATE/watch.pid"
interval="${DUX_WATCH_INTERVAL_SECS:-30}"
stale_after="${DUX_STALE_SECS:-1200}"
grace="${DUX_WATCH_GRACE_SECS:-120}"
ledger="$DUX_ROOT/bin/dux-ledger"
backend="$DUX_ROOT/bin/dux-backend"
usage="usage: dux-watch [--once] | dux-watch eval <id>"

{ : >> "$events"; } 2>/dev/null || finding "cannot write $events"

status_state() {  # $1 id; last status word, or empty when no status exists
  local last
  last="$(tail -n 1 "$DUX_TASKS/$1/status.log" 2>/dev/null)"
  printf '%s' "${last%%:*}"
}

endpoint_of() {  # $1 id; state file wins over the ledger
  local ep
  ep="$(cat "$DUX_STATE/$1.endpoint" 2>/dev/null)" || ep="$($ledger get "$1" endpoint 2>/dev/null)"
  printf '%s' "$ep"
}

backend_evidence() {  # $1 endpoint; present, gone, or unknown:<message>
  local err rc
  err="$($backend exists "$1" 2>&1 >/dev/null)"; rc=$?
  case "$rc" in
    0) echo present ;;
    1) echo gone ;;
    *) echo "unknown:backend cannot tell whether $1 exists: $err" ;;
  esac
}

# The first line is alive, gone, starting, or unknown:<why>. Later note: lines
# carry container evidence without changing the wrapper pid's verdict.
liveness() {  # $1 id
  local id epfile pidfile ep wpid evidence anchor age
  id="$1"; epfile="$DUX_STATE/$id.endpoint"; pidfile="$DUX_STATE/$id.pid"
  ep="$(endpoint_of "$id")"

  if [ -e "$pidfile" ] || [ -L "$pidfile" ]; then
    wpid="$(cat "$pidfile" 2>/dev/null)" || { echo "unknown:cannot read $pidfile"; return 0; }
    case "$wpid" in
      ''|*[!0-9]*) echo "unknown:$pidfile does not hold a pid ('$(cap_line "$wpid")')"; return 0 ;;
    esac
    if pid_runs "$wpid" "dux-worker-wrap $id"; then
      echo alive
      if [ -z "$ep" ] || [ "$ep" = - ]; then
        echo "note:no endpoint recorded"
      else
        evidence="$(backend_evidence "$ep")"
        case "$evidence" in
          present) ;;
          gone) echo "note:container $ep is gone but wrapper pid $wpid is alive" ;;
          unknown:*) echo "note:${evidence#unknown:}" ;;
        esac
      fi
    else
      echo gone
      if [ -n "$ep" ] && [ "$ep" != - ]; then
        evidence="$(backend_evidence "$ep")"
        [ "$evidence" != present ] || echo "note:container $ep remains but wrapper pid $wpid is gone"
        case "$evidence" in unknown:*) echo "note:${evidence#unknown:}" ;; esac
      fi
    fi
    return 0
  fi

  if [ -z "$ep" ] || [ "$ep" = - ]; then
    echo "unknown:no endpoint and no pidfile"
    return 0
  fi
  if [ -e "$epfile" ] || [ -L "$epfile" ]; then anchor="$epfile"; else anchor="$DUX_TASKS/$id/status.log"; fi
  age=$(( $(date +%s) - $(mtime_epoch "$anchor" 2>/dev/null || echo 0) ))
  if [ "$age" -lt "$grace" ]; then echo starting; else echo gone; fi
  evidence="$(backend_evidence "$ep")"
  case "$evidence" in unknown:*) echo "note:${evidence#unknown:}" ;; esac
}

last_activity() {  # $1 id; newer of the status log and wrapper pidfile
  local a b
  a="$(mtime_epoch "$DUX_TASKS/$1/status.log" 2>/dev/null || echo 0)"
  b="$(mtime_epoch "$DUX_STATE/$1.pid" 2>/dev/null || echo 0)"
  if [ "$a" -ge "$b" ]; then echo "$a"; else echo "$b"; fi
}

# ---- terminal handoffs ---------------------------------------------------
# A task finishes when a run publishes a handoff Dux itself built from proved
# evidence. Everything below checks that the handoff belongs to this task's run
# and says something Dux is willing to write, before any of it is written.
run_of() {  # $1 id; the run recorded for the task, or nothing
  local f="$DUX_STATE/$1.run"
  { [ ! -L "$f" ] && [ -f "$f" ]; } || return 0
  sed -n 's/^run=//p' "$f" | take_line
}

context_field() {  # $1 id, $2 key
  local f="$DUX_STATE/$1.result-context"
  { [ ! -L "$f" ] && [ -f "$f" ]; } || return 0
  sed -n "s/^$2=//p" "$f" | take_line
}

receipt_complete() {  # $1 id; the five /ship phases, in order, and nothing else
  local f="$DUX_STATE/$1.ship-receipt"
  { [ ! -L "$f" ] && [ -f "$f" ]; } || return 1
  [ "$(sed -n 's/^phase=\([a-z]*\) .*/\1/p' "$f" | tr '\n' ' ')" = "checks review security pr ci " ]
}

# Prints "<event> <status line>", or reject:<why>. Nothing is written here.
read_handoff() {  # $1 id, $2 sequence
  local d f run want status event repo
  d="$DUX_STATE/$1.handoffs/$2"
  for f in run status event; do
    { [ ! -L "$d/$f" ] && [ -f "$d/$f" ]; } || { echo "reject:handoff $2 has no $f file"; return 0; }
    [ "$(wc -l < "$d/$f" | tr -d " ")" -eq 1 ] || { echo "reject:handoff $2 does not hold one $f line"; return 0; }
  done
  run="$(cat "$d/run")"; status="$(cat "$d/status")"; event="$(cat "$d/event")"
  want="$(run_of "$1")"
  if [ -n "$want" ]; then
    [ "$run" = "$want" ] || { echo "reject:handoff $2 names run $run, not this task's run"; return 0; }
  else
    [ "$run" = - ] || { echo "reject:handoff $2 names a run but $1 recorded none"; return 0; }
  fi
  # One clean line, in the grammar, inside the cap. A handoff Dux built is
  # already all three; one that is not did not come from a run of this task.
  # cap_line is the writer's own cleaning and capping, so comparing against it
  # draws the line in exactly one place. A range like [ -~] in a case pattern
  # would not: a bracket range matches by the locale's collation, and on bash
  # 3.2 in a UTF-8 locale that rejects ordinary text.
  [ "$status" = "$(cap_line "$status")" ] \
    || { echo "reject:handoff $2 does not hold one status line"; return 0; }
  case "$status" in
    done:\ ?*|failed:\ ?*|blocked:\ ?*|needs-decision:\ ?*|ended:\ ?*) ;;
    *) echo "reject:handoff $2 does not hold one status line"; return 0 ;;
  esac
  [ "$event" = "${status%%:*}" ] \
    || { echo "reject:handoff $2 records event $event for a ${status%%:*} status"; return 0; }
  if [ "$event" = "done" ]; then
    repo="$(context_field "$1" repo)"
    case "$(context_field "$1" shape)" in
      scout)
        [ "$status" = "done: report" ] \
          || { echo "reject:a pull request does not complete a scout task"; return 0; } ;;
      plan|ship)
        case "$status" in
          "done: PR https://github.com/"*) ;;
          *) echo "reject:a report does not complete a $(context_field "$1" shape) task"; return 0 ;;
        esac
        # The url Dux stores names the repository Dux registered, or none.
        case "${status#done: PR https://github.com/}" in
          "$repo"/pull/*) ;;
          *) echo "reject:handoff $2 names a pull request outside $repo"; return 0 ;;
        esac
        if [ "$(context_field "$1" shape)" = ship ] && ! receipt_complete "$1"; then
          echo "reject:no complete /ship receipt behind the result for $1"; return 0
        fi ;;
      *) echo "reject:handoff $2 completes $1, which recorded no shape"; return 0 ;;
    esac
  fi
  printf '%s %s\n' "$event" "$status"
}

# Each step leaves its own mark, so a watcher killed part-way through writes the
# rest and nothing twice. The sequence itself is never removed; teardown owns it.
consume_handoff() {  # $1 id, $2 sequence, $3 event, $4 status line
  local d
  d="$DUX_STATE/$1.handoffs/$2"
  if [ ! -e "$d/did-status" ]; then
    printf '%s\n' "$4" >> "$DUX_TASKS/$1/status.log" \
      || { log "watch: cannot append to the status log for $1"; return 1; }
    : > "$d/did-status"
  fi
  if [ ! -e "$d/did-event" ]; then
    printf '%s %s: %s\n' "$(now)" "$3" "$1" >> "$events" \
      || { log "watch: cannot append to $events"; return 1; }
    : > "$d/did-event"
  fi
  "$ledger" set "$1" state "$3" \
    || { log "watch: ledger not updated for $1; the handoff stays until it is"; return 1; }
  case "$4" in
    "done: PR "*)
      "$ledger" set "$1" pr "${4#done: PR }" \
        || { log "watch: ledger url not updated for $1; the handoff stays until it is"; return 1; } ;;
  esac
  : > "$d/consumed"
  "$backend" notify Dux "$3: $1" >/dev/null 2>&1 || true
}

# The first line is the ledger target or skip:<why>. Any later note: lines are
# observations to log without changing the target.
target_for() {  # $1 id
  local id st live verdict notes age target n
  id="$1"; st="$(status_state "$id")"
  case "$st" in
    # A terminal-looking line proves nothing on its own. Either a handoff put it
    # there, in which case the ledger already followed it, or nothing did.
    ''|working|done|failed|blocked|needs-decision|ended) ;;
    *) echo "skip:status log ends in an unknown state '$st'"; return 0 ;;
  esac
  if n="$(next_handoff "$id")"; then echo "handoff:$n"; return 0; fi
  live="$(liveness "$id")"
  verdict="$(printf '%s\n' "$live" | sed -n '1p')"
  notes="$(printf '%s\n' "$live" | sed -n '2,$p')"
  case "$verdict" in
    alive)
      age=$(( $(date +%s) - $(last_activity "$id") ))
      if [ "$age" -ge "$stale_after" ]; then target=stale; else target=running; fi ;;
    gone) target=dead ;;
    starting) target=running ;;
    unknown:*) target="skip:${verdict#unknown:}" ;;
  esac
  echo "$target"
  [ -z "$notes" ] || printf '%s\n' "$notes"
}

emit() {  # $1 id, $2 state; record first so a crash cannot lose the wake
  printf '%s %s: %s\n' "$(now)" "$2" "$1" >> "$events" || { log "watch: cannot append to $events"; return 0; }
  "$ledger" set "$1" state "$2" || log "watch: ledger not updated for $1; the event will repeat until it is"
  "$backend" notify Dux "$2: $1" >/dev/null 2>&1 || true
}

# Running and stale are the tasks a watcher normally looks at. A task whose
# ledger already moved but whose handoff is not marked consumed is the crash
# case, and only this list brings the watcher back to finish it.
watched_ids() {
  local id d
  "$ledger" list --state running
  "$ledger" list --state stale
  for d in "$DUX_STATE"/*.handoffs; do
    [ -d "$d" ] || continue
    id="${d##*/}"; id="${id%.handoffs}"
    next_handoff "$id" >/dev/null || continue
    printf '%s\n' "$id"
  done
}

observations=""
pass() {
  local id lstate result target line seen="" done_ids="" handed event status
  for id in $(watched_ids); do
    case " $done_ids " in *" $id "*) continue ;; esac
    done_ids="$done_ids $id"
    lstate="$("$ledger" get "$id" state 2>/dev/null)" || continue
    result="$(target_for "$id")"
    target="$(printf '%s\n' "$result" | sed -n '1p')"
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      case "$line" in
        note:*) seen="${seen}dux: watch: $id: ${line#note:}"$'\n' ;;
      esac
    done <<EOF
$(printf '%s\n' "$result" | sed -n '2,$p')
EOF
    case "$target" in
      skip:*) seen="${seen}finding: watch: $id: ${target#skip:}"$'\n'; continue ;;
      handoff:*)
        handed="$(read_handoff "$id" "${target#handoff:}")"
        case "$handed" in
          reject:*) seen="${seen}finding: watch: $id: ${handed#reject:}"$'\n'; continue ;;
        esac
        event="${handed%% *}"; status="${handed#* }"
        consume_handoff "$id" "${target#handoff:}" "$event" "$status" || true
        continue ;;
    esac
    [ "$target" != "$lstate" ] || continue
    if [ "$target" = running ]; then
      "$ledger" set "$id" state running && "$ledger" unack "$id" && log "watch: $id resumed"
      continue
    fi
    emit "$id" "$target"
  done
  if [ "$seen" != "$observations" ]; then
    observations="$seen"
    if [ -z "$seen" ]; then log "watch: every task answers again"; else printf '%s' "$seen" >&2; fi
  fi
}

case "${1:-}" in
  eval)
    [ $# -eq 2 ] || finding "$usage"
    valid_task_id "$2"
    "$ledger" get "$2" state >/dev/null || exit $?
    # Reads and reports; a pending handoff is resolved to what it would write,
    # never consumed. Only a pass consumes one.
    result="$(target_for "$2")"
    case "$result" in
      handoff:*)
        handed="$(read_handoff "$2" "${result#handoff:}")"
        case "$handed" in
          reject:*) printf 'skip:%s\n' "${handed#reject:}" ;;
          *) printf '%s\n' "${handed%% *}" ;;
        esac ;;
      *) printf '%s\n' "$result" ;;
    esac
    exit 0 ;;
  --once) [ $# -eq 1 ] || finding "$usage"; pass; exit 0 ;;
  '') ;;
  *) finding "$usage" ;;
esac

echo $$ > "$watchpid" || finding "cannot write $watchpid"
log "watch: started pid $$, every ${interval}s, stale after ${stale_after}s"
sleeper=""
trap 'log "watch: stopping"; [ -z "$sleeper" ] || kill "$sleeper" 2>/dev/null; exit 0' TERM INT
while :; do
  [ "$(cat "$watchpid" 2>/dev/null)" = "$$" ] || { log "watch: $watchpid names another watcher; exiting"; exit 0; }
  pass
  sleep "$interval" & sleeper=$!
  wait "$sleeper"
  sleeper=""
done
