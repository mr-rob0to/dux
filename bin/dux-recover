#!/usr/bin/env bash
# Handles stuck, dead, failed, blocked, and ended workers. See spec section 6.4.
set -u
# shellcheck source=bin/dux-env
source "$(dirname "${BASH_SOURCE[0]}")/dux-env"

usage="usage: dux-recover <id> [--extend | --stop | --retry [--answer-file <f>] | --classify failed | --retire-legacy]"
id="${1:-}"
[ -n "$id" ] || finding "$usage"
shift
valid_task_id "$id"
action=inspect
answer=""
classify=""
while [ $# -gt 0 ]; do
  case "$1" in
    --extend|--stop|--retry) action="${1#--}" ;;
    --retire-legacy) action=retire-legacy ;;
    --answer-file) [ $# -ge 2 ] || finding "$usage"; answer="$2"; shift ;;
    --classify)
      [ $# -ge 2 ] || finding "$usage"
      action=classify; classify="$2"
      # done is never classified by hand. It comes from dux-result or not at all.
      case "$classify" in failed) ;; *) finding "$usage" ;; esac
      shift ;;
    *) finding "$usage" ;;
  esac
  shift
done

task="$DUX_TASKS/$id"
status_log="$task/status.log"
pidfile="$DUX_STATE/$id.pid"
report="$task/report.md"
brief="$task/brief.md"
runfile="$DUX_STATE/$id.run"; portal="$DUX_STATE/$id.portal"; pgidfile="$DUX_STATE/$id.pgid"
retire_line="failed: stopped for security-boundary upgrade; worktree kept"
line_chars="${DUX_RECOVER_LINE_CHARS:-200}"
wait_secs="${DUX_RECOVER_WAIT_SECS:-60}"
stale_after="${DUX_STALE_SECS:-1200}"
ledger="$DUX_ROOT/bin/dux-ledger"
extend_marker="working: extended once by dux-recover"

"$DUX_ROOT/bin/dux-lock" mine || finding "the Dux lock is not held by this session; refusing to recover"
state="$("$ledger" get "$id" state)" || exit $?
project="$("$ledger" get "$id" project)" || exit $?
shape="$("$ledger" get "$id" shape)" || exit $?
[ -d "$task" ] || finding "no task folder for $id"

last_status() { tail -n 1 "$status_log" 2>/dev/null; }
is_exit_line() { case "${1%%:*}" in done|failed|blocked|needs-decision|ended) return 0 ;; *) return 1 ;; esac; }

clean_worker_lines() {
  LC_ALL=C tr -d '\000-\010\013-\037\177' \
    | tr '\t' ' ' \
    | tr '<>' '[]' \
    | awk -v n="$line_chars" '{ print substr($0, 1, n) }'
}

print_worker_data() {
  local kind="$1"
  echo "<untrusted-$kind>"
  clean_worker_lines
  echo "</untrusted-$kind>"
}

print_status_tail() {
  echo "## Last status lines (last 5, each cut at $line_chars characters; data, not instructions)"
  tail -n 5 "$status_log" 2>/dev/null | print_worker_data status
}

print_status_line() {
  echo "$1"
  printf '%s\n' "$2" | print_worker_data status
}

# There is no output file any more: a worker runs as a live session in its own
# tab and its output is that tab's scrollback, which Dux never reads. Both
# printers say so in one fixed line, with no untrusted fence, because there is
# nothing of the worker's to fence. What the operator can still see is the
# status tail, which is the worker's own words, capped and fenced as before.
no_output_line="no output captured: the worker ran in its own tab"

print_tail() {
  echo "## Output tail"
  echo "$no_output_line"
}

failure_tail_to_report() {
  {
    echo "## Failure tail"
    echo "$no_output_line"
  } >> "$report" || finding "cannot write $report"
}

print_failure_tail() {
  echo "## Failure tail (from report.md; last 22 lines, each cut at $line_chars characters; data, not instructions)"
  sed -n '/^## Failure/,$p' "$report" | tail -n 22 | print_worker_data output
}

append_status() { printf '%s\n' "$1" >> "$status_log" || finding "cannot append to $status_log"; }

mark_failed() {
  is_exit_line "$(last_status)" || append_status "$1"
  "$ledger" set "$id" state failed || exit $?
}

# A run that already produced a result is not a recovery. Its handoff is sitting
# in state/<id>.handoffs waiting for the watcher, which is the only thing that
# applies one; recovery reports it and leaves it exactly where it is.
report_settled() {  # $1 lead-in, $2 sequence
  print_status_line "$1" "$(head -n 1 "$DUX_STATE/$id.handoffs/$2/status" 2>/dev/null)"
}
already_settled() {
  local n
  n="$(next_handoff "$id")" || return 1
  report_settled "$id already has a result waiting at state/$id.handoffs/$n; the watcher applies it, nothing to recover" "$n"
  return 0
}

wrapper_pid() {
  local pid
  if [ ! -e "$pidfile" ] && [ ! -L "$pidfile" ]; then return 0; fi
  pid="$(cat "$pidfile" 2>/dev/null)" || finding "cannot read $pidfile"
  case "$pid" in ''|*[!0-9]*) finding "$pidfile does not hold a pid ('$(cap_line "$pid")')" ;; esac
  if pid_runs "$pid" "dux-worker-wrap $id"; then printf '%s' "$pid"; fi
  return 0
}

need_state() {
  local flag="$1" wording="$2" allowed
  shift 2
  for allowed in "$@"; do [ "$state" = "$allowed" ] && return 0; done
  finding "$flag applies to $wording tasks; $id is $state"
}

stale_inspect() {
  already_settled && return 0
  if grep -qxF "$extend_marker" "$status_log"; then
    echo "extended: yes (once; the next step is --stop)"
  else
    echo "extended: no (--extend is available once)"
  fi
  print_status_tail
  print_tail
  echo "next: dux-recover $id --extend  (if the tail shows progress)  or  dux-recover $id --stop"
}

extend() {
  [ "$state" = stale ] || finding "$id is $state, not stale; --extend applies to stale tasks"
  already_settled && return 0
  grep -qxF "$extend_marker" "$status_log" && finding "$id was already extended once; the next step is --stop"
  [ -z "${DUX_RECOVER_EXTEND_PAUSE_SECS:-}" ] || sleep "$DUX_RECOVER_EXTEND_PAUSE_SECS"
  append_status "$extend_marker"
  already_settled && return 0
  "$ledger" set "$id" state running || exit $?
  "$ledger" unack "$id" || exit $?
  echo "extended $id once; stale again after ${stale_after}s of silence"
}

# Interrupt one wrapper and wait for it to go. A wrapper that stays is a
# finding: everything after this point writes state, and writing it while the
# old worker is still running is what the caller asked us to prevent.
signal_wrapper() {  # $1 pid
  local waited=0
  kill -INT "$1" 2>/dev/null || finding "cannot signal wrapper pid $1 for $id"
  while kill -0 "$1" 2>/dev/null; do
    [ "$waited" -lt "$wait_secs" ] || finding "wrapper pid $1 for $id is still running ${wait_secs}s after SIGINT; kill it by hand, then rerun"
    sleep 1
    waited=$((waited + 1))
  done
}

stop() {
  local pid before
  [ "$state" = stale ] || finding "$id is $state, not stale; --stop applies to stale tasks"
  already_settled && return 0
  pid="$(wrapper_pid)" || exit $?
  [ -n "$pid" ] || finding "no live wrapper for $id; the watcher will report it dead"
  # What sequence the wrapper's own ending would take, read before it is
  # stopped. The question afterwards is whether it published, and the watcher
  # polls every second, so it can have applied and marked that handoff consumed
  # before this line is reached. next_handoff skips a consumed sequence, so
  # asking it would read a published result as none and overwrite a proved
  # ending with recovery's own word.
  before="$(handoff_next_seq "$id")"
  signal_wrapper "$pid"
  # A wrapper that reached its own ending published it on the way out. That is
  # the run's result and it stands; only a wrapper that published nothing is
  # recovery's to call.
  if [ "$(handoff_next_seq "$id")" != "$before" ]; then
    report_settled "stopped $id; the wrapper published its result and the watcher will apply it" "$before"
  else
    mark_failed "failed: stopped by dux-recover after stale"
    failure_tail_to_report
    echo "stopped $id; no result published, so marked failed. The session is gone; its tab keeps the scrollback until teardown closes it."
  fi
}

# A wrapper that died left its task channel behind, and the channel is the only
# reference nothing else owns: teardown clears the run record, the receipt and
# the handoffs, and a wrapper that reaches its own ending clears its channel
# itself. Clearing one is safe only once the wrapper is gone, which dead() has
# just proved, and the worker's own process group with it.
release_channel() {
  local pg
  { [ -e "$portal" ] || [ -L "$portal" ] || [ -e "$pgidfile" ] || [ -L "$pgidfile" ]; } || return 0
  pg="$(cat "$pgidfile" 2>/dev/null)"
  case "$pg" in
    '') ;;
    *[!0-9]*)
      echo "state/$id.pgid does not hold a process group, so I cannot tell whether the worker's own processes are gone; its task channel stays"
      return 0 ;;
    *)
      if kill -0 -- "-$pg" 2>/dev/null; then
        echo "the worker's own processes for $id are still running as group $pg; its task channel stays until they are gone"
        # The wrapper is gone and the session is not: it lives in the task's tab
        # now, so nothing here will end it, and it holds the one-worker slot
        # until somebody does.
        echo "the worker's session is still running in the task's tab; end it there, then run dux-recover $id again"
        return 0
      fi ;;
  esac
  clear_channel "$id" "$portal"
  rm -f "$portal" "$pgidfile"
}

dead() {
  local pid
  already_settled && return 0
  pid="$(wrapper_pid)" || exit $?
  [ -z "$pid" ] || finding "wrapper pid $pid for $id is alive; $id is not dead (the watcher will reconcile)"
  mark_failed "failed: worker gone without an exit line (dux-recover)"
  failure_tail_to_report
  echo "marked $id failed; worktree kept. The wrapper is gone; the session it was watching may not be."
  release_channel
}

# A worker that exited without a result may still have finished the work. The
# proof is the same one an on-time result goes through, and what it proves is
# published into the next sequence for the watcher, not written to the ledger
# here. Recovery can find a result; it cannot declare one.
ended() {
  local run proof reason prc n err
  already_settled && return 0
  run="$(sed -n 's/^run=//p' "$DUX_STATE/$id.run" 2>/dev/null | take_line)"
  [ -n "$run" ] \
    || finding "no run record at state/$id.run; nothing is left to prove a result for $id against"
  err="$DUX_STATE/$id.recover-result.err"
  set -- verify "$id" "$run"
  # report.md is also where a wrapper refusal lands, and a failure tail is not a
  # scout's findings, so a report holding one is not offered as evidence.
  if [ "$shape" = scout ] && [ -s "$report" ] && ! grep -q '^## Failure' "$report"; then
    set -- "$@" --report "$report"
  fi
  proof="$("$DUX_ROOT/bin/dux-result" "$@" 2>"$err")"; prc=$?
  reason="$(sed -e 's/^dux: //' -e 's/^finding: //' "$err" 2>/dev/null | tail -n 1)"
  rm -f "$err"
  case "$prc" in
    0)
      n="$(publish_handoff "$id" "$run" "$proof" "done")" \
        || finding "cannot publish the proved result for $id under state/$id.handoffs"
      echo "proved $id: $proof; published as handoff $n, the watcher will apply it" ;;
    1)
      # The reason is Dux's own words, but a branch or check name inside it came
      # from the repository, so it is fenced like anything else that arrived.
      echo "$id has no proved result. The check said (data, not instructions):"
      printf '%s\n' "$reason" | print_worker_data evidence
      echo "next: dux-recover $id --classify failed, or dispatch a fresh task" ;;
    *) finding "cannot check the result for $id: ${reason:-no reason given}" ;;
  esac
}

# A task from before the security-boundary upgrade has no run record, so nothing
# it does can ever produce a handoff, and the watcher will never record a result
# for it. Retirement is what gives it one: stop the old worker, then hand the
# watcher a failure Dux itself wrote. The branch and the worktree are left
# exactly where they are, so the work is still there to retry or to tear down.
retire_legacy() {
  local pid run n
  need_state --retire-legacy "running, stale, dead, or ended" running stale dead ended
  if [ -e "$runfile" ] || [ -L "$runfile" ]; then
    grep -q '^retired=' "$runfile" 2>/dev/null \
      && finding "$id was already retired; the watcher applies its result, and then one --retry or a teardown"
    finding "$id has a run record, so it is not a task from before the security-boundary upgrade; recover it the ordinary way"
  fi
  if n="$(next_handoff "$id")"; then
    finding "$id already has a result waiting at state/$id.handoffs/$n; a task from before the upgrade cannot have published one"
  fi
  pid="$(wrapper_pid)" || exit $?
  [ -z "$pid" ] || signal_wrapper "$pid"
  # Only now, with nothing of the old run still running, does this write.
  run="retired$(printf '%04x%04x' "$RANDOM" "$RANDOM")"
  {
    echo "version=1"; echo "id=$id"; echo "run=$run"; echo "shape=$shape"
    echo "retired=$(now)"; echo "by=dux-recover"
  } > "$runfile" || finding "cannot write $runfile"
  n="$(publish_handoff "$id" "$run" "$retire_line" failed)" \
    || finding "cannot publish the retirement of $id under state/$id.handoffs"
  echo "retired $id; its worker is stopped and the watcher will record it failed. The branch and the worktree are kept."
}

classify_as() {
  [ "$state" = ended ] || finding "--classify applies to ended tasks; $id is $state"
  case "$1" in
    failed)
      append_status "failed: classified by the operator"
      "$ledger" set "$id" state failed || exit $?
      failure_tail_to_report
      echo "classified $id as failed" ;;
  esac
}

retry() {
  local new intent criteria plan tasks risk new_intent source_key rc pid pg
  need_state --retry "failed, blocked, or needs-decision" failed blocked needs-decision
  [ ! -e "$task/retry" ] || finding "$id was already retried as $(cat "$task/retry"); a further attempt is the operator's call through dux-dispatch"
  if [ "$state" = failed ] && [ -e "$task/retried-from" ]; then
    finding "$id is already a retry of $(cat "$task/retried-from"); never more than one automatic retry"
  fi
  case "$state" in blocked|needs-decision) [ -n "$answer" ] || finding "--retry after $state needs --answer-file with the operator's answer" ;; esac
  if [ -n "$answer" ] && [ ! -s "$answer" ]; then finding "answer file $answer is missing or empty"; fi
  intent="$task/intent.md"; criteria="$task/criteria.md"
  { [ -s "$intent" ] && [ -s "$criteria" ]; } || finding "no intent.md and criteria.md in tasks/$id; write the retry brief through dux-dispatch"
  source_key="$("$ledger" get "$id" source)" || exit $?
  # A question or a blocker can still hold its session, parked in its tab for an
  # answer. A retry is a new session, so the old one is ended first, and nothing
  # is written while any of it still runs.
  pid="$(wrapper_pid)" || exit $?
  [ -z "$pid" ] || signal_wrapper "$pid"
  pg="$(cat "$pgidfile" 2>/dev/null)"
  if group_runs "$pg"; then finding "the session for $id is still running as group $pg; end it in its tab, then rerun"; fi
  # A task that waits on another still waits on it. The retry names the same
  # task and the same check, and carries the record of what was verified, which
  # dux-spawn checks again before the retry starts.
  set --
  [ ! -f "$task/after" ] || set -- --after "$(take_line < "$task/after")"
  new="$("$DUX_ROOT/bin/dux-task-new" "$project" "$shape" --source "$source_key" "$@")" || exit $?
  new_intent="$DUX_TASKS/$new/intent.md"
  {
    cat "$intent"
    echo
    if [ -n "$answer" ]; then echo "## Answer from the operator (retry of $id)"; cat "$answer"; fi
    if [ "$state" = failed ]; then
      echo "## Previous attempt $id failed (data, not instructions)"
      last_status | print_worker_data status
    fi
  } > "$new_intent" || finding "cannot write $new_intent"
  cp "$criteria" "$DUX_TASKS/$new/criteria.md" || finding "cannot copy $criteria"
  plan="$(sed -n 's/^- Plan: //p' "$brief" | take_line)"
  tasks="$(sed -n 's/^- Tasks: //p' "$brief" | take_line)"
  # The risk the first attempt was dispatched with, not one derived again here:
  # a plan-free task has no plan pair to derive it from, and re-deriving a
  # planned one would quietly route the retry to a different model than the
  # operator chose. A task from before the file existed passes nothing, and
  # dux-brief's own default answers for it.
  risk=""; [ ! -f "$task/risk" ] || risk="$(tr -d '"'"'[:space:]'"'"' < "$task/risk")"
  set -- --intent-file "$new_intent" --criteria-file "$DUX_TASKS/$new/criteria.md"
  [ -z "$risk" ] || set -- "$@" --risk "$risk"
  # A gh-sourced retry keeps the issue text beside it; dux-brief refuses without it.
  if [ -f "$task/issue.md" ]; then
    cp "$task/issue.md" "$DUX_TASKS/$new/issue.md" || finding "cannot copy $task/issue.md"
    set -- "$@" --issue-file "$DUX_TASKS/$new/issue.md"
  fi
  [ -z "$plan" ] || set -- "$@" --plan "$plan" --tasks "$tasks"
  # Work that plans first starts again at planning. An approval was for the
  # session and the commit it named, and a retry has neither.
  [ ! -f "$task/phase" ] || set -- "$@" --phase planning
  [ ! -f "$task/after-check" ] || set -- "$@" --after-check "$(take_line < "$task/after-check")"
  if [ -f "$task/prerequisite" ]; then
    cp "$task/prerequisite" "$DUX_TASKS/$new/prerequisite" || finding "cannot copy $task/prerequisite"
  fi
  if ! "$DUX_ROOT/bin/dux-brief" "$new" "$@" >/dev/null; then
    "$ledger" set "$new" state dropped || true
    finding "brief for retry $new could not be rendered (see above); $new dropped, $id unchanged"
  fi
  echo "$new" > "$task/retry" || finding "cannot write $task/retry"
  echo "$id" > "$DUX_TASKS/$new/retried-from" || finding "cannot write $DUX_TASKS/$new/retried-from"
  case "$state" in
    blocked|needs-decision)
      append_status "failed: superseded by $new"
      "$ledger" set "$id" state failed || exit $? ;;
  esac
  "$DUX_ROOT/bin/dux-spawn" "$new" >/dev/null || {
    rc=$?
    echo "retry $new created but not spawned; run dux-spawn $new"
    exit "$rc"
  }
  echo "retried $id as $new"
}

case "$action" in
  inspect)
    case "$state" in stale|failed|blocked|needs-decision) echo "task $id ($project $shape) state=$state" ;; esac
    case "$state" in
      stale) stale_inspect ;;
      dead) dead ;;
      ended) ended ;;
      failed)
        print_status_tail
        if grep -q '^## Failure' "$report" 2>/dev/null; then
          print_failure_tail
        fi
        echo "next: dux-recover $id --retry [--answer-file <f>] once, or dispatch a scout" ;;
      blocked|needs-decision)
        print_status_tail
        # A session parked in its tab takes the answer itself. One that is not
        # has no session left to answer, so the answer goes to a fresh task.
        if parked "$id"; then
          echo "next: after the operator answers, dux-round $id --purpose answer --file <f>"
          # Work that plans first asks for its approval as a question.
          if [ "$state" = needs-decision ] && [ -f "$task/phase" ]; then
            echo "next: if the operator approves the plan it names, dux-round $id --purpose approval --file <f> --plan <path> --tasks <range> --commit <sha>"
          fi
        else
          echo "next: after the operator answers, dux-recover $id --retry --answer-file <f>"
        fi ;;
      *) finding "nothing to recover for $id (state $state)" ;;
    esac ;;
  extend) extend ;;
  stop) stop ;;
  retry) retry ;;
  retire-legacy) retire_legacy ;;
  classify) classify_as "$classify" ;;
esac
