#!/usr/bin/env bash
# Runs inside the worker container, in the task's worktree. Spec sections 5.4, 5.5, 9.
set -u
# shellcheck source=bin/dux-env
source "$(dirname "${BASH_SOURCE[0]}")/dux-env"

[ $# -eq 1 ] || die "usage: dux-worker-wrap <id>"
id="$1"
# Before any path is built from it. refuse() below appends to $task/status.log and
# $task/report.md, and for id=".." the directory check passes because
# $DUX_TASKS/.. is data/, so a refusal would drop those two files into data/.
valid_task_id "$id"
task="$DUX_TASKS/$id"; brief="$task/brief.md"; status_log="$task/status.log"
settings="$task/worker-settings.json"; hooks="$task/hooks"
out="$DUX_STATE/$id.out"; pidfile="$DUX_STATE/$id.pid"; pgidfile="$DUX_STATE/$id.pgid"
poll="${DUX_WRAP_POLL_SECS:-5}"; beat="${DUX_HEARTBEAT_SECS:-300}"
branch="dux/$id"

[ -d "$task" ] || finding "no task folder for $id"
# From here on a refusal is a failed task with a reason, not a silent pane.
refuse() {
  printf 'failed: wrapper: %s\n' "$*" >> "$status_log" 2>/dev/null
  { echo "## Failure"; echo "wrapper: $*"; } >> "$task/report.md" 2>/dev/null
  finding "$*"
}
[ -s "$brief" ] || refuse "no brief for $id"
[ -d "$hooks" ] || refuse "no hooks dir for $id; dux-worktree installs it"
project="$("$DUX_ROOT/bin/dux-ledger" get "$id" project 2>&1)" || refuse "$project"
shape="$("$DUX_ROOT/bin/dux-ledger" get "$id" shape 2>&1)" || refuse "$shape"
base="$("$DUX_ROOT/bin/dux-project" get "$project" base 2>&1)" || refuse "$base"
[ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" = "$branch" ] \
  || refuse "dux-worker-wrap must run inside the worktree on $branch (cwd is $PWD)"

harness="$(task_harness "$task")"
why="$(harness_refusal "$harness")" || refuse "$why"
worker_path="$(strip_dux_bin "$PATH")"
dux_path="$PATH"; PATH="$worker_path"
command -v "$harness" >/dev/null 2>&1 \
  || { PATH="$dux_path"; refuse "$harness is not on PATH inside the worker container"; }
PATH="$dux_path"
# shellcheck source=/dev/null
source "$DUX_ROOT/bin/workers/$harness.sh"

# One model file per harness: config/models for claude, config/models-<name> for the rest.
models="$DUX_CONFIG/models"; [ "$harness" = claude ] || models="$DUX_CONFIG/models-$harness"
[ -s "$models" ] || refuse "missing $models; run dux-install"
spec="$(tr ' ' '\n' < "$models" | sed -n "s/^$shape=//p" | head -1)"
case "$spec" in *:*) ;; *) refuse "model entry for $shape in $models must be <model>:<effort>, got '${spec:-nothing}'" ;; esac
model="${spec%%:*}"; effort="${spec#*:}"
[ -n "$model" ] || refuse "empty model for $shape in $models"
worker_effort_ok "$effort" || refuse "effort $effort is not valid for $harness"
if [ "$harness" = claude ] && [ ! -s "$settings" ]; then refuse "no worker settings for $id; dux-brief renders them"; fi

echo $$ > "$pidfile" || refuse "cannot write $pidfile"
: >> "$status_log" || refuse "cannot write $status_log"
# Installed before anything can start the harness: a signal in a gap between the
# fork and the trap would kill the wrapper and leave the harness unsupervised.
# bash starts background children with INT ignored, so INT here becomes TERM to it.
wpid=""; pgid=""; signalled=0
trap 'signalled=1; if [ -n "$pgid" ]; then kill -TERM -- "-$pgid" 2>/dev/null || true;
      elif [ -n "$wpid" ]; then kill -TERM "$wpid" 2>/dev/null || true; fi' INT TERM

# ---- the task channel ----------------------------------------------------
# The worker never writes canonical state. It proposes into a channel of its
# own and the wrapper decides what, if anything, reaches status.log and
# report.md. The random name and the file modes catch mistakes and stale
# writes; they are not a boundary against the worker, which runs as we do.
runfile="$DUX_STATE/$id.run"; portal="$DUX_STATE/$id.portal"
context="$DUX_STATE/$id.result-context"; channels="$DUX_STATE/channels"
mkdir -p "$channels" 2>/dev/null || refuse "cannot create $channels"
chmod 700 "$channels" || refuse "cannot restrict $channels"
channel="$(mktemp -d "$channels/$id.XXXXXXXX" 2>/dev/null)" || refuse "cannot create a task channel for $id"
chmod 700 "$channel" || refuse "cannot restrict the task channel for $id"
# Physical path: git and the pre-push hook resolve symlinks, so record the name
# the kernel agrees on rather than the one mktemp happened to print.
channel="$(cd "$channel" 2>/dev/null && pwd -P)" || refuse "cannot resolve the task channel for $id"
run="${channel##*.}"
status_outbox="$channel/status.outbox"; report_outbox="$channel/report.outbox"
for f in "$status_outbox" "$report_outbox"; do
  { : > "$f" && chmod 600 "$f"; } || refuse "cannot create $f"
done
c_brief="$channel/brief.md"; c_settings="$channel/worker-settings.json"
{ cp "$brief" "$c_brief" && chmod 400 "$c_brief"; } || refuse "cannot stage the brief in the task channel"
if [ -s "$settings" ]; then
  { cp "$settings" "$c_settings" && chmod 400 "$c_settings"; } \
    || refuse "cannot stage the worker settings in the task channel"
fi
# The worker's git runs the channel's copy of the hooks, so the set it obeys is
# the set Dux staged for this run and nothing in the task folder is on its path.
cp -R "$hooks" "$channel/hooks" || refuse "cannot stage the task hooks in the task channel"
# Read-only files, but a writable directory: a channel a refusal leaves behind
# has to stay removable, and a mode the worker can lift anyway is worth nothing
# bought at the price of a tree nothing can clear.
chmod 700 "$channel/hooks" || refuse "cannot restrict $channel/hooks"
[ ! -f "$channel/hooks/pre-push" ] || chmod 500 "$channel/hooks/pre-push" \
  || refuse "cannot restrict $channel/hooks/pre-push"
printf '%s\n' "$channel" > "$portal" || refuse "cannot write $portal"

# What a result has to be checked against, written before the worker can
# change anything: the run it belongs to and the project facts Dux registered.
worktree_path="$(pwd -P)"
origin_url="$(git config --get remote.origin.url 2>/dev/null || true)"
slug="-"
case "$origin_url" in
  *github.com[:/]*) slug="${origin_url#*github.com}"; slug="${slug#[:/]}"; slug="${slug%.git}" ;;
esac
{
  echo "version=1"; echo "id=$id"; echo "run=$run"; echo "shape=$shape"
  echo "project=$project"; echo "repo=$slug"; echo "base=$base"; echo "branch=$branch"
  echo "worktree=$worktree_path"
  echo "plan=$(sed -n 's/^- Plan: //p' "$brief" | head -1)"
  echo "tasks=$(sed -n 's/^- Tasks: //p' "$brief" | head -1)"
} > "$context" || refuse "cannot write $context"
context_id="$(git hash-object --stdin < "$context" 2>/dev/null)" \
  || refuse "cannot hash $context"
{
  echo "version=1"; echo "id=$id"; echo "run=$run"; echo "wrapper=$$"
  echo "shape=$shape"; echo "worktree=$worktree_path"; echo "channel=$channel"
  echo "context=$context_id"
} > "$runfile" || refuse "cannot write $runfile"

cleanup_channel() {  # the channel and the references only this run owns
  rm -rf "$channel" 2>/dev/null || log "task channel $channel left in place"
  rm -f "$portal" "$pgidfile"
}

# ---- the managed process group -------------------------------------------
# The harness and the ordinary children it starts are one process group, so
# "the worker has stopped" is a question about the group, not about the one
# process Dux happened to fork. A child that deliberately starts a session of
# its own escapes this, and that is outside what Dux claims to contain.
group_alive() { [ -n "$pgid" ] && kill -0 -- "-$pgid" 2>/dev/null; }

stop_group() {  # TERM, then KILL; returns 1 if anything is still there
  local i limit signals
  # Tests only: nothing a test can start survives KILL, so without this the
  # branch that refuses a survivor could never be seen to fail.
  signals="${DUX_WRAP_STOP_SIGNALS:-on}"
  group_alive || return 0
  limit=$(( ${DUX_WRAP_STOP_GRACE_SECS:-10} * 5 ))
  if [ "$signals" = on ]; then kill -TERM -- "-$pgid" 2>/dev/null || true; fi
  i=0
  while [ "$i" -lt "$limit" ]; do
    group_alive || return 0
    i=$((i + 1)); sleep 0.2
  done
  log "worker group $pgid for $id ignored TERM; killing it"
  if [ "$signals" = on ]; then kill -KILL -- "-$pgid" 2>/dev/null || true; fi
  i=0
  while [ "$i" -lt 25 ]; do
    group_alive || return 0
    i=$((i + 1)); sleep 0.2
  done
  return 1
}

# Nothing of Dux's session reaches the worker: not the orchestrator's own
# harness variables, not the backend it runs under, not a git config the
# operator set for themselves, and not the directory the dux commands live in.
# It gets its task channel back, and the hook path for this run. Matched with
# case, not a regex: BSD sed has no \| alternation, so a GNU pattern here would
# unset nothing.
scrub_worker_env() {
  local v
  for v in $(env | cut -d= -f1); do
    case "$v" in
      DUX_*|CLAUDECODE|CLAUDE_*|HERDR_*|TMUX|TMUX_*|GIT_CONFIG_*) unset "$v" ;;
    esac
  done
  export PATH="$worker_path"
  export DUX_STATUS_LOG="$status_outbox" DUX_REPORT="$report_outbox"
  export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0="$channel/hooks"
}

mirroring=1
mirror() {  # $1 dux state. The pane says which state, never what the worker wrote.
  [ "$mirroring" = 1 ] || return 0
  local s
  case "$1" in working) s=working ;; needs-decision|blocked) s=blocked ;; *) s=idle ;; esac
  if ! "$DUX_ROOT/bin/dux-backend" report "$id" "$s" "dux $id: $1" 2>/dev/null; then
    mirroring=0; log "status mirroring unavailable on this backend; status.log remains the truth"
  fi
}

# ---- reading the worker's proposals --------------------------------------
LINE_CAP=200      # bytes of one cleaned status line
STATUS_CAP=65536  # bytes of status.outbox over a whole run
REPORT_CAP=1048576  # bytes of report.outbox over a whole run
accepted=0        # bytes of status.outbox already read
accepted_sum=""   # what those bytes were, so a rewrite of them is visible
terminal=""       # the one terminal proposal, held back until the run is over
violation=""      # the first proposal rule the worker broke
clean_text() { LC_ALL=C tr -d '\000-\010\013-\037\177'; }

# A checksum, not a byte-for-byte copy: this catches a worker rewriting its own
# proposals by mistake and a stale writer from an earlier run, which is what the
# threat boundary asks of it. A worker set on defeating it runs as we do and
# does not need to bother.
prefix_sum() { head -c "$2" "$1" | cksum; }

import_proposals() {  # $1 "final" when nothing more is coming
  local size partial plen i count line clean
  local -a lines
  [ -z "$violation" ] || return 0
  [ -f "$status_outbox" ] || return 0
  size="$(wc -c < "$status_outbox" | tr -d ' ')"
  # Checked before a byte of the new region is read, so a worker cannot make
  # Dux hold its whole outbox in memory just by writing a big one.
  if [ "$size" -gt "$STATUS_CAP" ]; then
    violation="the worker for $id wrote more than $STATUS_CAP bytes of status proposals"; return 0
  fi
  # What Dux has already read is the worker's own record too, and it does not
  # get to change it. Checked before the "anything new?" test, because a rewrite
  # that keeps the length would otherwise never be looked at.
  if [ "$size" -lt "$accepted" ]; then
    violation="the worker for $id truncated its status proposals"; return 0
  fi
  if [ "$accepted" -gt 0 ] && [ "$(prefix_sum "$status_outbox" "$accepted")" != "$accepted_sum" ]; then
    violation="the worker for $id rewrote a status proposal it had already made"; return 0
  fi
  [ "$size" -gt "$accepted" ] || return 0
  # Bounded by the size just measured: the worker keeps writing while we read,
  # and bytes past that point belong to the next pass, not this one.
  # A line it has not finished writing is not a proposal yet either, so the
  # bytes after the last newline stay unread too.
  partial=""; [ -n "$(tail -c "+$size" "$status_outbox" | head -c 1)" ] && partial=yes
  lines=(); i=0
  while IFS= read -r line || [ -n "$line" ]; do
    i=$((i + 1)); lines[i]="$line"
  done < <(tail -c "+$((accepted + 1))" "$status_outbox" | head -c "$((size - accepted))")
  count=$i
  plen=0
  if [ -n "$partial" ] && [ "$count" -gt 0 ]; then
    plen="$(printf '%s' "${lines[$count]}" | wc -c | tr -d ' ')"
    count=$((count - 1))
  fi
  accepted=$((size - plen))
  accepted_sum="$(prefix_sum "$status_outbox" "$accepted")"
  i=0
  while [ "$i" -lt "$count" ]; do
    i=$((i + 1))
    clean="$(printf '%s' "${lines[$i]}" | clean_text)"
    if [ "$(printf '%s' "$clean" | wc -c | tr -d ' ')" -gt "$LINE_CAP" ]; then
      violation="the worker for $id proposed a status line over $LINE_CAP bytes"; return 0
    fi
    # A worker gets one terminal line and then stops. A second one, or anything
    # at all behind one, means the run Dux is about to prove is not the run the
    # worker was still having.
    if [ -n "$terminal" ]; then
      case "$clean" in
        needs-decision:\ ?*|blocked:\ ?*|done:\ ?*|failed:\ ?*)
          violation="the worker for $id proposed a second terminal status" ;;
        *) violation="the worker for $id kept writing after its terminal status" ;;
      esac
      return 0
    fi
    case "$clean" in
      working:\ ?*)
        printf '%s\n' "$clean" >> "$status_log"; mirror working ;;
      needs-decision:\ ?*|blocked:\ ?*|done:\ ?*|failed:\ ?*)
        terminal="$clean" ;;
      # Not relayed, not logged: an operator reads fixed text chosen by state,
      # never a line the worker wrote.
      *) violation="the worker for $id proposed a line that is not a status line"; return 0 ;;
    esac
  done
  # Nothing more is coming, so bytes with no newline behind them are a line the
  # worker started and never finished, not one it is still writing.
  if [ "${1:-}" = final ] && [ -n "$partial" ]; then
    violation="the worker for $id left a status line unfinished"
  fi
}

intent_line="$(awk '/^## Intent$/ { f = 1; next } f && NF { print substr($0, 1, 60); exit }' "$brief")"
"$DUX_ROOT/bin/dux-backend" title "$project: $intent_line" 2>/dev/null || log "title not set on this backend"

[ "$signalled" = 0 ] || refuse "signalled before the harness started"
# Tests only: widens the gap the trap cannot cover, so the re-check below is reachable.
[ -z "${DUX_WRAP_FORK_PAUSE_SECS:-}" ] || sleep "$DUX_WRAP_FORK_PAUSE_SECS"
# Job control puts the worker in a process group of its own. Nothing but
# /dev/null on input, the run's output file on 1 and 2, and no inherited
# descriptor above them: a child holding one open outlives what opened it.
set -m
( scrub_worker_env; worker_run "$c_brief" "$model" "$effort" "$c_settings" ) \
  < /dev/null > "$out" 2>&1 3>&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- &
wpid=$!
set +m
pgid="$(ps -o pgid= -p "$wpid" 2>/dev/null | tr -d ' ')"
case "$pgid" in ''|*[!0-9]*) pgid="$wpid" ;; esac
# Signalling our own group would kill the wrapper along with the worker.
if [ "$pgid" = "$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')" ]; then
  kill -TERM "$wpid" 2>/dev/null || true
  refuse "the worker for $id did not get a process group of its own"
fi
echo "$pgid" > "$pgidfile" \
  || { kill -TERM -- "-$pgid" 2>/dev/null || true; refuse "cannot write $pgidfile"; }
# A signal between the check above and this assignment found an empty wpid and did
# nothing, and the harness would then run unsupervised. Deliver it now.
[ "$signalled" = 0 ] || kill -TERM -- "-$pgid" 2>/dev/null || true

last_status() { grep -v '^working: heartbeat$' "$status_log" 2>/dev/null | tail -n 1; }

last_size=0; last_beat="$(date +%s)"
while kill -0 "$wpid" 2>/dev/null; do
  sleep "$poll"
  import_proposals
  # A broken proposal ends the run: stop reading what the worker is writing and
  # refuse once its group is gone.
  if [ -n "$violation" ]; then break; fi
  kill -0 "$wpid" 2>/dev/null || break   # never heartbeat past the harness's exit
  now_s="$(date +%s)"
  if [ $((now_s - last_beat)) -ge "$beat" ]; then
    size="$(wc -c < "$out" | tr -d ' ')"
    if [ "$size" -gt "$last_size" ] && [ -z "$terminal" ]; then
      echo "working: heartbeat" >> "$status_log"
    fi
    last_size=$size; last_beat=$now_s
  fi
done
# A run the wrapper ended itself has to be stopped before the wait below, or a
# harness that does not exit on its own holds the wrapper here forever.
if [ -n "$violation" ]; then stop_group || log "worker group $pgid for $id is still running"; fi
wait "$wpid"; rc=$?
trap - INT TERM
# The harness has gone; whatever it left running has not. Nothing this run
# reports counts until the whole group is proven gone.
if ! stop_group; then
  finding "the worker group $pgid for $id survived TERM and KILL; state/$id.pgid and its task channel are left for recovery"
fi

import_proposals final
[ -z "$violation" ] || refuse "$violation"
if [ -s "$report_outbox" ]; then
  # Measured before a byte of it is copied, for the same reason as the status cap.
  report_size="$(wc -c < "$report_outbox" | tr -d ' ')"
  [ "$report_size" -le "$REPORT_CAP" ] \
    || refuse "the worker for $id wrote more than $REPORT_CAP bytes of report"
  clean_text < "$report_outbox" >> "$task/report.md" || refuse "cannot write $task/report.md"
fi

if [ -n "$terminal" ]; then
  printf '%s\n' "$terminal" >> "$status_log"; mirror "${terminal%%:*}"
elif [ "$rc" -ne 0 ]; then
  echo "failed: worker exited $rc" >> "$status_log"; mirror failed
else
  echo "ended: exit 0 without terminal status" >> "$status_log"; mirror ended
fi
last="$(last_status)"
if [ "${last%%:*}" = failed ]; then
  { echo "## Failure tail"; tail -n 20 "$out"; } >> "$task/report.md"
fi
cleanup_channel
log "worker for $id exited $rc; last status: $last"
exit 0
