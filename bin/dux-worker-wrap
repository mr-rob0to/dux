#!/usr/bin/env bash
# Runs inside the worker container, in the task's worktree. Spec sections 5.4, 5.5, 9.
set -u
# shellcheck source=bin/dux-env
source "$(dirname "${BASH_SOURCE[0]}")/dux-env"

[ $# -eq 1 ] || die "usage: dux-worker-wrap <id>"
id="$1"
# Before any path is built from it. refuse() below appends to $task/status.log and
# $task/report.md, and for id=".." the directory check passes because
# $DUX_TASKS/.. is data/, so a refusal would drop those two files into data/.
valid_task_id "$id"
task="$DUX_TASKS/$id"; brief="$task/brief.md"; status_log="$task/status.log"
settings="$task/worker-settings.json"; hooks="$task/hooks"
pidfile="$DUX_STATE/$id.pid"; pgidfile="$DUX_STATE/$id.pgid"
epfile="$DUX_STATE/$id.endpoint"
poll="${DUX_WRAP_POLL_SECS:-5}"; beat="${DUX_HEARTBEAT_SECS:-300}"
# A real Claude Code start is slower than it looks: measured 2026-09-15 on a
# quiet machine, 40s from dux-spawn to a harness the multiplexer would name, and
# longer under load. The window only decides how long a start that has really
# failed takes to be reported, and spawn does not wait on it, so it is generous.
start_secs="${DUX_WRAP_START_SECS:-120}"
branch="dux/$id"

[ -d "$task" ] || finding "no task folder for $id"
# From here on a refusal is a failed task with a reason, not a silent pane. Once
# this run has a record to name, that reason travels as a handoff like any other
# result; before it has one there is no run for a handoff to belong to, so the
# line goes straight to the status log and the watcher reads a dead task.
run=""; handoff_ready=0
refuse() {
  local line
  line="$(cap_line "failed: wrapper: $*")"
  # An ending like any other, so a session kept alive for parking goes with it.
  [ -z "${pgid:-}" ] || stop_pgid "$pgid" || log "worker group $pgid for $id is still running"
  if [ "$handoff_ready" = 1 ]; then
    publish_handoff "$id" "$run" "$line" failed >/dev/null \
      || log "cannot publish the refusal for $id; state/$id.handoffs holds nothing"
  else
    printf '%s\n' "$line" >> "$status_log" 2>/dev/null
  fi
  { echo "## Failure"; echo "wrapper: $*"; } >> "$task/report.md" 2>/dev/null
  finding "$*"
}
[ -s "$brief" ] || refuse "no brief for $id"
[ -d "$hooks" ] || refuse "no hooks dir for $id; dux-worktree installs it"
project="$("$DUX_ROOT/bin/dux-ledger" get "$id" project 2>&1)" || refuse "$project"
shape="$("$DUX_ROOT/bin/dux-ledger" get "$id" shape 2>&1)" || refuse "$shape"
base="$("$DUX_ROOT/bin/dux-project" get "$project" base 2>&1)" || refuse "$base"
[ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" = "$branch" ] \
  || refuse "dux-worker-wrap must run inside the worktree on $branch (cwd is $PWD)"

harness="$(task_harness "$task")"
why="$(harness_refusal "$harness")" || refuse "$why"
worker_path="$(strip_dux_bin "$PATH")"
dux_path="$PATH"; PATH="$worker_path"
command -v "$harness" >/dev/null 2>&1 \
  || { PATH="$dux_path"; refuse "$harness is not on PATH inside the worker container"; }
PATH="$dux_path"
# shellcheck source=/dev/null
source "$DUX_ROOT/bin/workers/$harness.sh"

# One model file per harness: config/models for claude, config/models-<name> for the rest.
models="$DUX_CONFIG/models"; [ "$harness" = claude ] || models="$DUX_CONFIG/models-$harness"
[ -s "$models" ] || refuse "missing $models; run dux-install"
# A ship task is routed by the risk dux-brief stored, not by its shape: bounded
# work goes to the smaller model and complex work to the larger one. A task from
# before the file existed has no risk to read, and the careful reading is the
# one that costs nothing but tokens, so it is complex. Anything else in the file
# is a refusal: a model chosen by guessing is the silent downgrade this routing
# exists to avoid. plan and scout still route by shape.
key="$shape"
if [ "$shape" = ship ]; then
  risk=complex
  if [ -f "$task/risk" ]; then risk="$(tr -d '[:space:]' < "$task/risk")"; fi
  case "$risk" in
    bounded|complex) ;;
    *) refuse "risk for $id must be bounded or complex, not '$(cap_line "$risk")'" ;;
  esac
  key="$risk"
  # The review mode travels to the worker in the brief, not through here. What
  # this reads it for is to refuse early: a mode nothing can read fails at
  # dux-result's gate instead, after a whole session has been spent. A task
  # briefed before the file existed has none, and dux-result reads that as the
  # old separate-review requirement, which is the careful reading and needs no
  # refusal here.
  if [ -f "$task/review" ]; then
    review="$(sed -n 's/^mode=//p' "$task/review" | take_line | tr -d '[:space:]')"
    case "$review" in
      combined|separate) ;;
      *) refuse "review mode for $id must be combined or separate, not '$(cap_line "$review")'" ;;
    esac
  fi
fi
spec="$(tr ' ' '\n' < "$models" | sed -n "s/^$key=//p" | take_line)"
case "$spec" in *:*) ;; *) refuse "model entry for $key in $models must be <model>:<effort>, got '${spec:-nothing}'" ;; esac
model="${spec%%:*}"; effort="${spec#*:}"
[ -n "$model" ] || refuse "empty model for $key in $models"
worker_effort_ok "$effort" || refuse "effort $effort is not valid for $harness"
if [ "$harness" = claude ] && [ ! -s "$settings" ]; then refuse "no worker settings for $id; dux-brief renders them"; fi

echo $$ > "$pidfile" || refuse "cannot write $pidfile"
: >> "$status_log" || refuse "cannot write $status_log"
# Installed before anything can start the harness: a signal in the gap between
# starting it and discovering its group would leave the harness unsupervised.
# The wrapper does not fork the harness any more, so a group is the only handle
# there is; signalled is what the code after discovery reads to deliver a signal
# that arrived while there was nothing to send it to.
pgid=""; signalled=0
trap 'signalled=1; [ -z "$pgid" ] || kill -TERM -- "-$pgid" 2>/dev/null || true' INT TERM

# ---- the task channel ----------------------------------------------------
# The worker never writes canonical state. It proposes into a channel of its
# own and the wrapper decides what, if anything, reaches status.log and
# report.md. The random name and the file modes catch mistakes and stale
# writes; they are not a boundary against the worker, which runs as we do.
runfile="$DUX_STATE/$id.run"; portal="$DUX_STATE/$id.portal"
context="$DUX_STATE/$id.result-context"; channels="$DUX_STATE/channels"
# This run owns its references. One already there is an earlier run's, and
# nothing here can tell a leftover from a live one, so it is the operator's to
# clear through recovery. -L as well as -e: a dangling symlink is a reference
# too, and writing through it would put this run's state somewhere else.
for f in "$runfile" "$portal" "$pgidfile" "$context" "$(handoff_home "$id")"; do
  { [ ! -e "$f" ] && [ ! -L "$f" ]; } \
    || refuse "$id already has a reference from an earlier run at state/${f##*/}"
done
mkdir -p "$channels" 2>/dev/null || refuse "cannot create $channels"
chmod 700 "$channels" || refuse "cannot restrict $channels"
channel="$(mktemp -d "$channels/$id.XXXXXXXX" 2>/dev/null)" || refuse "cannot create a task channel for $id"
chmod 700 "$channel" || refuse "cannot restrict the task channel for $id"
# Physical path: git and the pre-push hook resolve symlinks, so record the name
# the kernel agrees on rather than the one mktemp happened to print.
channel="$(cd "$channel" 2>/dev/null && pwd -P)" || refuse "cannot resolve the task channel for $id"
run="${channel##*.}"
status_outbox="$channel/status.outbox"; report_outbox="$channel/report.outbox"
for f in "$status_outbox" "$report_outbox"; do
  { : > "$f" && chmod 600 "$f"; } || refuse "cannot create $f"
done
# The file this run made, not whatever is at that name later. A worker that
# removes an outbox and writes a new one in its place gets a different inode,
# and so does a channel directory swapped underneath it.
# GNU first, then BSD. The order is not a preference: GNU stat reads -f as
# --file-system, so the BSD spelling makes it print a whole filesystem report to
# stdout and then fail, and taking both answers would give this file a different
# identity every time it was asked. Only digits and one colon get through, so a
# report that leaked in is not mistaken for an identity either.
path_ident() {  # $1 path; "<device>:<inode>"
  local s
  s="$(stat -c '%d:%i' "$1" 2>/dev/null)" || s="$(stat -f '%d:%i' "$1" 2>/dev/null)"
  case "$s" in ''|*[!0-9:]*) return 1 ;; esac
  printf '%s' "$s"
}
# A pin is a second name for the outbox, kept for the whole run. Without one the
# inode is not evidence: Linux frees it the moment the outbox is removed and
# hands the same number to the file written in its place, so the replacement
# reads as the original. A pinned inode cannot be handed out, so a replacement
# always differs. Removing the pin is a replacement too, since the comparison
# then has nothing to answer with.
status_pin="$channel/.status.pin"; report_pin="$channel/.report.pin"
ln "$status_outbox" "$status_pin" || refuse "cannot pin the status outbox for $id"
ln "$report_outbox" "$report_pin" || refuse "cannot pin the report outbox for $id"
outbox_intact() {  # $1 outbox, $2 its pin
  local a b
  [ ! -L "$1" ] && [ -f "$1" ] || return 1
  a="$(path_ident "$1")" || return 1
  b="$(path_ident "$2")" || return 1
  [ "$a" = "$b" ]
}

c_brief="$channel/brief.md"; c_settings="$channel/worker-settings.json"
{ cp "$brief" "$c_brief" && chmod 400 "$c_brief"; } || refuse "cannot stage the brief in the task channel"
# The heartbeat is two hooks in the task's settings, each touching a file in
# this run's channel. dux-brief could not know the channel, so it left a token;
# this is where the path is known. Single-quoted in the template, so a channel
# holding a quote would end the literal early, as it would in the recorder.
beatfile="$channel/beat"
if [ -s "$settings" ]; then
  case "$channel" in *\'*) refuse "cannot stage the worker settings for $id: the task channel holds a quote" ;; esac
  rendered="$(cat "$settings")"; token='__CHANNEL__'; rendered="${rendered//$token/$channel}"
  { printf '%s\n' "$rendered" > "$c_settings" && chmod 400 "$c_settings"; } \
    || refuse "cannot stage the worker settings in the task channel"
fi
# A ship worker records each /ship phase through a recorder made for this task
# and this run. It is a script in the channel rather than a variable because the
# worker's environment carries no Dux path of any kind, and the id and run are
# baked in so a worker cannot file a phase against a sibling task.
ship_record=""
write_recorder() {  # for the run in $run
  {
    echo '#!/bin/sh'
    echo '# Records one /ship phase. Made for one task and one run; do not reuse.'
    printf "exec env DUX_HOME='%s' '%s/bin/dux-result' record-ship '%s' '%s' \"\$@\"\n" \
      "$DUX_HOME" "$DUX_ROOT" "$id" "$run"
  } > "$ship_record"
}
if [ "$shape" = ship ]; then
  for q in "$DUX_HOME" "$DUX_ROOT" "$id" "$run"; do
    case "$q" in *\'*) refuse "cannot build a ship recorder for $id: a path or id holds a quote" ;; esac
  done
  ship_record="$channel/ship-record"
  write_recorder || refuse "cannot stage the ship recorder in the task channel"
  chmod 500 "$ship_record" || refuse "cannot restrict $ship_record"
fi
printf '%s\n' "$channel" > "$portal" || refuse "cannot write $portal"

# What a result has to be checked against, written before the worker can
# change anything: the run it belongs to and the project facts Dux registered.
# Each round writes both again, for its own run.
worktree_path="$(pwd -P)"
slug="$(github_slug .)" || slug="-"
round=0
write_run_records() {
  local since context_id
  # Where the branch stood before this run could move it. A first run is round 0.
  since="$(git rev-parse --verify -q "refs/heads/$branch" 2>/dev/null)" \
    || refuse "cannot read the tip of $branch for $id"
  {
    echo "version=1"; echo "id=$id"; echo "run=$run"; echo "shape=$shape"
    echo "project=$project"; echo "repo=$slug"; echo "base=$base"; echo "branch=$branch"
    echo "worktree=$worktree_path"
    echo "plan=$(sed -n 's/^- Plan: //p' "$brief" | take_line)"
    echo "tasks=$(sed -n 's/^- Tasks: //p' "$brief" | take_line)"
    echo "round=$round"; echo "since=$since"
  } > "$context" || refuse "cannot write $context"
  context_id="$(git hash-object --stdin < "$context" 2>/dev/null)" \
    || refuse "cannot hash $context"
  {
    echo "version=1"; echo "id=$id"; echo "run=$run"; echo "wrapper=$$"
    echo "shape=$shape"; echo "worktree=$worktree_path"; echo "channel=$channel"
    echo "context=$context_id"
  } > "$runfile" || refuse "cannot write $runfile"
}
write_run_records
# From here a result can name the run it belongs to, so every terminal state
# this wrapper reaches, its own refusals included, leaves as a handoff.
handoff_ready=1

cleanup_channel() {  # the channel and the references only this run owns
  rm -rf "$channel" 2>/dev/null || log "task channel $channel left in place"
  rm -f "$portal" "$pgidfile"
}

# ---- the managed process group -------------------------------------------
# The harness and the ordinary children it starts are one process group, so
# "the worker has stopped" is a question about the group, not about the one
# process Dux happened to fork. A child that deliberately starts a session of
# its own escapes this, and that is outside what Dux claims to contain.
# dux-env's stop_pgid is the stop, shared with teardown.

# ---- reading the worker's proposals --------------------------------------
LINE_CAP=200      # bytes of one cleaned status line
STATUS_CAP=65536  # bytes of status.outbox over a whole run
REPORT_CAP=1048576  # bytes of report.outbox over a whole run
status_base=0     # where this run's status proposals begin; a round's start past the last run's
report_base=0     # where this run's report begins
accepted=0        # bytes of status.outbox already read
accepted_sum=""   # what those bytes were, so a rewrite of them is visible
terminal=""       # the one terminal proposal, held back until the run is over
violation=""      # the first proposal rule the worker broke
late=""           # what came after the terminal proposal; a violation unless the session parks
clean_text() { LC_ALL=C tr -d '\000-\010\013-\037\177'; }

# A checksum, not a byte-for-byte copy: this catches a worker rewriting its own
# proposals by mistake and a stale writer from an earlier run, which is what the
# threat boundary asks of it. A worker set on defeating it runs as we do and
# does not need to bother.
prefix_sum() { head -c "$2" "$1" | cksum; }

import_proposals() {  # $1 "final" when nothing more is coming
  local size partial plen i count line clean
  local -a lines
  [ -z "$violation" ] || return 0
  [ -f "$status_outbox" ] || return 0
  if ! outbox_intact "$status_outbox" "$status_pin"; then
    violation="the worker for $id replaced its status outbox"; return 0
  fi
  size="$(wc -c < "$status_outbox" | tr -d ' ')"
  # Checked before a byte of the new region is read, so a worker cannot make
  # Dux hold its whole outbox in memory just by writing a big one.
  if [ $((size - status_base)) -gt "$STATUS_CAP" ]; then
    violation="the worker for $id wrote more than $STATUS_CAP bytes of status proposals"; return 0
  fi
  # What Dux has already read is the worker's own record too, and it does not
  # get to change it. Checked before the "anything new?" test, because a rewrite
  # that keeps the length would otherwise never be looked at.
  if [ "$size" -lt "$accepted" ]; then
    violation="the worker for $id truncated its status proposals"; return 0
  fi
  if [ "$accepted" -gt 0 ] && [ "$(prefix_sum "$status_outbox" "$accepted")" != "$accepted_sum" ]; then
    violation="the worker for $id rewrote a status proposal it had already made"; return 0
  fi
  [ "$size" -gt "$accepted" ] || return 0
  # Bounded by the size just measured: the worker keeps writing while we read,
  # and bytes past that point belong to the next pass, not this one.
  # A line it has not finished writing is not a proposal yet either, so the
  # bytes after the last newline stay unread too.
  partial=""; [ -n "$(tail -c "+$size" "$status_outbox" | take_bytes 1)" ] && partial=yes
  lines=(); i=0
  while IFS= read -r line || [ -n "$line" ]; do
    i=$((i + 1)); lines[i]="$line"
  done < <(tail -c "+$((accepted + 1))" "$status_outbox" | take_bytes "$((size - accepted))")
  count=$i
  plen=0
  if [ -n "$partial" ] && [ "$count" -gt 0 ]; then
    plen="$(printf '%s' "${lines[$count]}" | wc -c | tr -d ' ')"
    count=$((count - 1))
  fi
  accepted=$((size - plen))
  accepted_sum="$(prefix_sum "$status_outbox" "$accepted")"
  i=0
  while [ "$i" -lt "$count" ]; do
    i=$((i + 1))
    clean="$(printf '%s' "${lines[$i]}" | clean_text)"
    if [ "$(printf '%s' "$clean" | wc -c | tr -d ' ')" -gt "$LINE_CAP" ]; then
      violation="the worker for $id proposed a status line over $LINE_CAP bytes"; return 0
    fi
    # A worker gets one terminal line and then stops. A second one, or anything
    # at all behind one, means the run Dux is about to prove is not the run the
    # worker was still having. Held until the run ends: a session that parks is
    # alive and may be typed to, and what it writes then belongs to no run.
    if [ -n "$terminal" ]; then
      if [ -z "$late" ]; then
        case "$clean" in
          needs-decision:\ ?*|blocked:\ ?*|done:\ ?*|failed:\ ?*)
            late="the worker for $id proposed a second terminal status" ;;
          *) late="the worker for $id kept writing after its terminal status" ;;
        esac
      fi
      return 0
    fi
    case "$clean" in
      working:\ ?*)
        printf '%s\n' "$clean" >> "$status_log" ;;
      needs-decision:\ ?*|blocked:\ ?*|done:\ ?*|failed:\ ?*)
        terminal="$clean" ;;
      # Not relayed, not logged: an operator reads fixed text chosen by state,
      # never a line the worker wrote.
      *) violation="the worker for $id proposed a line that is not a status line"; return 0 ;;
    esac
  done
  # Nothing more is coming, so bytes with no newline behind them are a line the
  # worker started and never finished, not one it is still writing.
  if [ "${1:-}" = final ] && [ -n "$partial" ]; then
    violation="the worker for $id left a status line unfinished"
  fi
}

# ---- starting the harness in the pane the task already has ----------------
# The wrapper does not fork the harness. dux-spawn opened a tab at a shell
# prompt and recorded where; the pane's shell runs the launcher, and the harness
# is that shell's child, not this process's. So everything below asks the
# multiplexer what is in the pane rather than asking bash about a child.
endpoint="$(cat "$epfile" 2>/dev/null)" \
  || refuse "cannot read state/$id.endpoint; dux-spawn records where the tab is"
[ -n "$endpoint" ] || refuse "no endpoint recorded for $id in state/$id.endpoint"
backend="$DUX_ROOT/bin/dux-backend"

intent_line="$(awk '/^## Intent$/ { f = 1; next } f && NF { print substr($0, 1, 60); exit }' "$brief")"
"$backend" title "$endpoint" "$project: $intent_line" 2>/dev/null || log "title not set on this backend"

# The launcher carries the scrub, the PATH and the outboxes, because the pane's
# shell is the harness's parent and no Dux environment reaches it.
launcher="$channel/launch"
worker_launcher "$launcher" "$c_brief" "$model" "$effort" "$c_settings" "$DUX_ROOT/bin" "$ship_record" \
  || refuse "cannot stage the launcher for $id in the task channel"

[ "$signalled" = 0 ] || refuse "signalled before the harness started"
# Tests only: widens the gap the trap cannot cover, so the re-check below is reachable.
[ -z "${DUX_WRAP_FORK_PAUSE_SECS:-}" ] || sleep "$DUX_WRAP_FORK_PAUSE_SECS"
# Quoted, because what `run` takes is a command line and a shell in the pane is
# what reads it: an unquoted DUX_HOME holding a space would arrive as a command
# and an argument. worker_launcher has already refused a path with a single
# quote in it, so nothing here can close the one this opens.
"$backend" run "$endpoint" "$worktree_path" "'$launcher'" \
  || refuse "cannot start the worker for $id in its tab at $endpoint"

# ---- finding the process the pane started ---------------------------------
# One question, asked once a second: what is the pane's foreground process, and
# is it the harness in this task's worktree? Herdr types the launcher into a
# shell, so there is a gap before the harness is there at all; tmux replaces the
# pane's shell with it, and the exec chain takes a moment to settle. Anything
# else at the end of the window is a refusal rather than a guess, because a
# wrapper supervising the wrong process would report on the wrong thing.
#
# Both refusals below say to end the session in the tab, because a refusal here
# is the one that can leave one running: the launcher has already gone to the
# pane, and a harness this never named leaves no group file, so nothing holds
# the one-worker slot for it. The operator reads that sentence with the failed
# wake, in front of the tab it names.
hname="$(worker_process_name)"
hpid=""; waited=0
while [ "$waited" -lt "$start_secs" ]; do
  found="$("$backend" pid "$endpoint" "$hname" 2>/dev/null)"; prc=$?
  if [ "$prc" = 0 ]; then
    hpid="${found%% *}"; rest="${found#* }"
    pgid="${rest%% *}"; hcwd="${rest#* }"
    if [ "$hcwd" = "$worktree_path" ]; then break; fi
    hpid=""; pgid=""
  elif [ "$prc" != 1 ]; then
    # 1 is "not there yet". Anything else is the multiplexer itself failing, and
    # waiting out the window would report that as a harness that never started.
    refuse "the multiplexer could not say what is running in the tab for $id at $endpoint; if a session is running there, end it in the tab before starting another task"
  fi
  waited=$((waited + 1)); sleep 1
done
[ -n "$hpid" ] \
  || refuse "the harness for $id did not appear in its pane within ${start_secs}s; if a session is running there, end it in the tab before starting another task"
echo "$pgid" > "$pgidfile" \
  || { kill -TERM -- "-$pgid" 2>/dev/null || true; refuse "cannot write $pgidfile"; }
# A signal that arrived before there was a group to send it to did nothing, and
# the harness would then run unsupervised. Deliver it now.
[ "$signalled" = 0 ] || kill -TERM -- "-$pgid" 2>/dev/null || true

# ---- the turn ending ------------------------------------------------------
# A plan or ship run that proposes a pull request, asks a question or reports a
# blocker may park: its session stays in the tab, idle, for feedback or an
# answer. What says its turn is over is the Stop hook, which
# touches <channel>/stopped when a turn ends and at no other time, and only a
# touch newer than the terminal line counts, since an earlier turn's Stop says
# nothing about this one. The wait running out proves nothing, so that run ends
# like any other.
wait_for_stop() {
  local waited=0 idle="${DUX_WRAP_IDLE_SECS:-60}"
  while [ "$waited" -lt "$idle" ]; do
    import_proposals
    { [ "$signalled" = 0 ] && [ -z "$violation" ] && pid_runs "$hpid" "$hname"; } || return 0
    [ -z "$(find "$channel/stopped" -newer "$status_outbox" 2>/dev/null)" ] || { stopped=yes; return 0; }
    waited=$((waited + 1)); sleep 1
  done
  log "worker for $id did not stop within ${idle}s of its terminal status; it is not parked"
}

# ---- the result ----------------------------------------------------------
# A terminal proposal is a request. For done the answer comes from dux-result,
# which reads Dux's own run record, the repository and GitHub and never the
# worker's word for any of it; the worker's own url, report claim and shape are
# not inputs. Every other terminal word is the worker reporting on itself, which
# only ever moves the task away from done, so its line stands.
prove_done() {
  local proof reason prc err="$channel/result.err"
  set -- verify "$id" "$run"
  [ "$report_size" -le "$report_base" ] || set -- "$@" --report "$report_outbox"
  proof="$("$DUX_ROOT/bin/dux-result" "$@" 2>"$err")"; prc=$?
  # dux-result's own words, not the worker's, but a check name inside them came
  # from GitHub, so they are cleaned and capped like anything else that arrived.
  reason="$(clean_text < "$err" 2>/dev/null | tail -n 1)"
  reason="${reason#dux: }"; reason="${reason#finding: }"
  rm -f "$err"
  case "$prc" in
    0)
      case "$proof" in
        done:\ ?*) result_line="$proof"; result_event="done" ;;
        *) refuse "dux-result answered this, which is not a result line: $proof" ;;
      esac ;;
    1)
      # Evidence that does not add up leaves the task ended. Dux never guesses done.
      result_line="$(cap_line "ended: the result was not proved: ${reason:-no reason given}")"
      result_event=ended ;;
    *) refuse "dux-result could not check the result for $id: ${reason:-no reason given}" ;;
  esac
}

# ---- parked ---------------------------------------------------------------
# A proved pull request whose turn has ended stays in its tab for feedback, and
# a question or a blocker for its answer. The marker is what tells the
# one-worker guard this session is idle: it names this run, this wrapper and
# this group, and nothing else writes it. The receipt stays where the watcher
# checks it until the watcher has applied this run's handoff, and only then is
# it kept under another name: delivered for a pull request, unfinished for a
# gate a question or a blocker stopped part-way, so the answer's run records a
# receipt of its own. The round is the next round's file, and it is taken up
# only after that too: a round writes the run records again, and a handoff still
# waiting behind them could never be read. The wait logs nothing per pass,
# because a task can sit parked for days.
park() {  # returns 0 once a round has started, 1 with a result still to publish
  local seq consumed parked="$DUX_STATE/$id.parked" receipt="$DUX_STATE/$id.ship-receipt" passes=0 archived=""
  local next="$task/round-$((round + 1)).md" kept=delivered
  seq="$(publish_handoff "$id" "$run" "$result_line" "$result_event")" || return 1
  consumed="$(handoff_home "$id")/$seq/consumed"
  { printf 'run=%s\nwrapper=%s\npgid=%s\n' "$run" "$$" "$pgid" > "$parked.tmp" && mv "$parked.tmp" "$parked"; } \
    || log "cannot write state/$id.parked; the session for $id stays, but counts as working"
  if [ "$result_event" = "done" ]; then
    log "worker for $id parked in its tab; feedback goes through dux-round"
  else
    kept=unfinished
    log "worker for $id parked in its tab at $result_event; an answer goes through dux-round"
  fi
  while [ "$signalled" = 0 ]; do
    if [ -z "$archived" ] && [ -e "$consumed" ]; then
      archived=yes
      [ ! -f "$receipt" ] || [ -L "$receipt" ] || mv "$receipt" "$receipt.$kept" \
        || log "cannot keep the $kept receipt for $id"
    fi
    if [ -n "$archived" ] && [ -f "$next" ]; then
      # The session is no longer idle from here, whatever happens next.
      rm -f "$parked"
      # The group this wrapper has held all along. Gone means the session was
      # ended in its tab, and the round would be typed into nothing.
      if ! group_runs "$pgid"; then
        result_line="failed: the session for $id was ended in its tab before round $((round + 1)) could run"
        result_event=failed
        return 1
      fi
      start_round "$next"
      return 0
    fi
    # Tests only: in production the wait lasts as long as the task stays parked.
    [ -z "${DUX_WRAP_PARK_MAX_PASSES:-}" ] || [ "$passes" -lt "$DUX_WRAP_PARK_MAX_PASSES" ] || break
    passes=$((passes + 1)); sleep 1
  done
  rm -f "$parked"
  trap - INT TERM
  stop_pgid "$pgid" || log "worker group $pgid for $id is still running"
  cleanup_channel
  log "parked worker for $id stopped; result: $result_line"
  exit 0
}

# ---- a round ----------------------------------------------------------------
# Feedback runs in the session that delivered the pull request, under this same
# wrapper, as a run of its own. Everything a run is checked against is made
# again before the line is typed, never after: the run id, the records that name
# it, the recorder, and where its proposals begin. So the parked run's terminal
# line and report are not read a second time, anything written while parked
# belongs to no run, and each run gets the whole of both caps.
start_round() {  # $1 the round file
  round=$((round + 1)); run="${channel##*.}r$round"
  write_run_records
  if [ -n "$ship_record" ]; then
    # Mode 500, so a plain write onto it fails.
    { chmod 600 "$ship_record" && write_recorder && chmod 500 "$ship_record"; } \
      || refuse "cannot rewrite the ship recorder for $id"
  fi
  { outbox_intact "$status_outbox" "$status_pin" && outbox_intact "$report_outbox" "$report_pin"; } \
    || refuse "the worker for $id replaced an outbox while its session was parked"
  status_base="$(wc -c < "$status_outbox" | tr -d ' ')"; accepted="$status_base"
  accepted_sum="$(prefix_sum "$status_outbox" "$accepted")"
  report_base="$(wc -c < "$report_outbox" | tr -d ' ')"
  terminal=""; late=""
  rm -f "$channel/stopped"
  { cp "$1" "$channel/round-$round.md" && chmod 400 "$channel/round-$round.md"; } \
    || refuse "cannot stage round $round in the task channel for $id"
  "$backend" prompt "$endpoint" "Read $channel/round-$round.md and follow it." \
    || refuse "cannot type round $round into the tab for $id at $endpoint"
}

# ---- supervising it -------------------------------------------------------
# Liveness is pid_runs, which is kill -0 and a command-line match. The match is
# what makes a process we did not fork safe to poll: nothing waits on it, so its
# pid can be recycled the moment it dies, and a recycled pid running something
# else reads as gone. Measured on Linux 2026-09-14: after a group stop the pid
# is a zombie kill -0 still answers for, and ps reads "[sleep] <defunct>", so
# the match is the part that says gone. A round comes back to the top of this
# loop, supervised the way the first run was.
while :; do
  last_beat="$(date +%s)"; last_beat_mtime="$(mtime_epoch "$beatfile" 2>/dev/null || true)"
  while pid_runs "$hpid" "$hname"; do
    sleep "$poll"
    import_proposals
    # A broken proposal ends the run, and so does the terminal line: the protocol
    # has one per run, and an interactive session left alive behind it would be a
    # second run Dux has no record of.
    if [ -n "$violation" ] || [ -n "$terminal" ]; then break; fi
    pid_runs "$hpid" "$hname" || break   # never heartbeat past the harness's exit
    now_s="$(date +%s)"
    if [ $((now_s - last_beat)) -ge "$beat" ]; then
      # The beat file is touched by the harness's own PostToolUse and Stop hooks.
      # Its mtime moving is a liveness hint of exactly the class the output file's
      # byte count was: never proof, never read for content.
      beat_mtime="$(mtime_epoch "$beatfile" 2>/dev/null || true)"
      if [ -n "$beat_mtime" ] && [ "$beat_mtime" != "$last_beat_mtime" ]; then
        echo "working: heartbeat" >> "$status_log"
      fi
      last_beat_mtime="$beat_mtime"; last_beat=$now_s
    fi
  done

  stopped=""
  case "$shape:$terminal" in
    plan:done:\ PR\ ?*|ship:done:\ PR\ ?*|plan:needs-decision:\ ?*|ship:needs-decision:\ ?*|plan:blocked:\ ?*|ship:blocked:\ ?*)
      [ -n "$violation" ] || wait_for_stop ;;
  esac

  # A run the wrapper ended itself has to be stopped, or an interactive session
  # sits at its prompt after the line that ended the run. A session that may park
  # is kept until its result is known.
  if [ -z "$stopped" ]; then
    if [ -n "$violation" ] || [ -n "$terminal" ]; then
      stop_pgid "$pgid" || log "worker group $pgid for $id is still running"
    fi
    trap - INT TERM
    # The harness has gone; whatever it left running has not. Nothing this run
    # reports counts until the whole group is proven gone.
    if ! stop_pgid "$pgid"; then
      finding "the worker group $pgid for $id survived TERM and KILL; state/$id.pgid and its task channel are left for recovery"
    fi
  fi

  # The references are how Task 2 finds this run's channel and its facts. If they
  # no longer name the channel this process made, nothing downstream can be sure
  # which run it is reading, so the result does not count.
  if [ "$(cat "$portal" 2>/dev/null)" != "$channel" ] \
    || ! grep -q "^channel=$channel\$" "$runfile" 2>/dev/null \
    || ! grep -q "^run=$run\$" "$runfile" 2>/dev/null; then
    refuse "the run references for $id no longer name this run's channel"
  fi

  # A session that parks is alive and may be typed to, so the two rules about how
  # a finished run's outbox ends, nothing after the terminal line and no line left
  # unfinished, are not applied to it. Every other ending has nothing more coming.
  if [ -z "$stopped" ]; then
    import_proposals final
    [ -n "$violation" ] || violation="$late"
  fi
  [ -z "$violation" ] || refuse "$violation"
  outbox_intact "$report_outbox" "$report_pin" \
    || refuse "the worker for $id replaced its report outbox"
  # Measured before a byte of it is copied, for the same reason as the status cap,
  # and only past where this run's report began.
  report_size="$(wc -c < "$report_outbox" | tr -d ' ')"
  if [ "$report_size" -gt "$report_base" ]; then
    [ $((report_size - report_base)) -le "$REPORT_CAP" ] \
      || refuse "the worker for $id wrote more than $REPORT_CAP bytes of report"
    tail -c "+$((report_base + 1))" "$report_outbox" | clean_text >> "$task/report.md" \
      || refuse "cannot write $task/report.md"
  fi

  # A harness the wrapper did not fork has no exit status to collect, so there is
  # no "exited <rc>" to report. Gone with no terminal line covers the operator
  # ending the session and the harness crashing alike, and ended is where both
  # belong: recovery proves what the run actually left behind.
  result_line=""; result_event=""
  if [ -n "$terminal" ]; then
    case "${terminal%%:*}" in
      done) prove_done ;;
      *) result_line="$terminal"; result_event="${terminal%%:*}" ;;
    esac
  else
    result_line="ended: the session ended without a terminal status"; result_event=ended
  fi
  if [ "$result_event" = failed ]; then
    # The worker's output is its tab's scrollback, which Dux never reads. The
    # fixed line is what the report says instead, so a reader is not left looking
    # for a tail that was never captured.
    { echo "## Failure tail"; echo "no output captured: the worker ran in its own tab"; } >> "$task/report.md"
  fi

  if [ -n "$stopped" ]; then
    # A proved pull request, a question or a blocker. A done the proof turned
    # into ended has nothing to wait for.
    case "$result_event" in
      done|needs-decision|blocked) if park; then continue; fi ;;
    esac
    # Not parked, so it is stopped like any other ending before the result goes out.
    trap - INT TERM
    stop_pgid "$pgid" \
      || finding "the worker group $pgid for $id survived TERM and KILL; state/$id.pgid and its task channel are left for recovery"
  fi
  break
done
publish_handoff "$id" "$run" "$result_line" "$result_event" >/dev/null \
  || finding "cannot publish the result for $id; state/$id.handoffs holds nothing"
cleanup_channel
log "worker for $id ended; result: $result_line"
exit 0
