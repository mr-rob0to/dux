#!/usr/bin/env bash
# Project registry. See spec section 4.
set -u
# shellcheck source=bin/dux-env
source "$(dirname "${BASH_SOURCE[0]}")/dux-env"

registry="$DUX_DATA/projects.md"
touch "$registry"
usage_add="usage: dux-project add <path> [--name <name>] [--base <branch>] [--issues off|label:<name>] [--worktree make|script|git]"
usage() { finding "$1"; }

field() {  # $1 name, $2 key
  grep "^- $1 " "$registry" | sed -n "s/.* $2=\([^ ]*\).*/\1/p"
}

valid_branch() { git check-ref-format --branch "$1" >/dev/null 2>&1; }

detect_worktree() {  # $1 path
  if [ -f "$1/Makefile" ] && grep -qE '^worktree:' "$1/Makefile"; then echo make
  elif ls "$1"/scripts/*worktree* >/dev/null 2>&1; then echo script
  else echo git; fi
}

resolve_base() {  # $1 path. Spec section 4 and /ship step 0.
  local p="$1" forge="" head="" docs=""
  if command -v gh >/dev/null 2>&1; then
    forge="$(cd "$p" && gh repo view --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null)" || forge=""
  fi
  head="$(cd "$p" && git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')" || head=""
  for f in CLAUDE.md AGENTS.md CONTRIBUTING.md; do
    [ -f "$p/$f" ] || continue
    # shellcheck disable=SC2016
    docs="$(grep -oiE '(base|default|trunk) branch[^`]{0,12}`[a-z0-9_./-]+`' "$p/$f" | take_line | grep -oE '`[^`]+`' | tr -d '`' || true)"
    [ -n "$docs" ] && break
  done
  local candidates
  candidates="$(printf '%s\n%s\n%s\n' "$docs" "$forge" "$head" | grep -v '^$' | sort -u)"
  [ -z "$candidates" ] && finding "base branch cannot be determined for $p (no gh, no origin/HEAD, no docs)"
  if [ "$(printf '%s\n' "$candidates" | wc -l | tr -d ' ')" -gt 1 ]; then
    finding "base branch signals disagree for $p: docs=${docs:-none} forge=${forge:-none} origin/HEAD=${head:-none}"
  fi
  valid_branch "$candidates" || finding "base branch signal is not a valid branch name: $candidates"
  echo "$candidates"
}

# Every place GitHub reads a pull request template from, one repo-relative path
# per line, in the order root, docs/, .github/; a folder form ends in "/".
# Prints nothing when the repo has none, so the caller decides what "none" says.
#
# GitHub's own docs give the three directories, say filenames are not case
# sensitive and may carry an extension such as .md or .txt, and allow a
# PULL_REQUEST_TEMPLATE/ folder of several in any of the three. They do not say
# which wins when a repo has more than one, which is why Dux never adds a second.
#
# A glob, not `find -maxdepth 1`: find does not descend a symlinked .github by
# default and a glob does, and a glob over a missing docs/ is simply an entry
# that fails the -d and -f tests below. A dangling symlink passes neither, so it
# is not a match and install_template's symlink refusal still fires on it.
find_templates() {  # $1 path
  local dir entry base low
  for dir in "" docs .github; do
    for entry in "$1${dir:+/$dir}"/*; do
      base="${entry##*/}"
      low="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"
      case "$low" in
        # The folder form is a directory; the file form is a regular file. A
        # directory named PULL_REQUEST_TEMPLATE.md is neither to GitHub.
        pull_request_template)   [ -d "$entry" ] || continue; printf '%s%s/\n' "${dir:+$dir/}" "$base" ;;
        pull_request_template.*) [ -f "$entry" ] || continue; printf '%s%s\n'  "${dir:+$dir/}" "$base" ;;
        *) continue ;;
      esac
    done
  done
}

install_template() {  # $1 path. Prints one line for the caller to relay.
  local gh="$1/.github" t="$1/.github/PULL_REQUEST_TEMPLATE.md"
  if [ -e "$t" ]; then log "existing PR template left alone: $t"; echo "existing PR template left alone"; return; fi
  if [ -L "$gh" ] || [ -L "$t" ]; then finding "refusing to write through a symlink at $gh"; fi
  mkdir -p "$gh" 2>/dev/null || finding "cannot create $gh"
  cp "$DUX_ROOT/templates/PULL_REQUEST_TEMPLATE.md" "$t" 2>/dev/null || finding "cannot write $t"
  echo "installed PR template; commit it in $1 before dispatching ship tasks"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  add)
    path=""; name=""; base=""; issues="off"; wt_flag=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --name) [ $# -ge 2 ] || usage "$usage_add"; name="$2"; shift 2 ;;
        --base) [ $# -ge 2 ] || usage "$usage_add"; base="$2"; shift 2 ;;
        --issues) [ $# -ge 2 ] || usage "$usage_add"; issues="$2"; shift 2 ;;
        --worktree) [ $# -ge 2 ] || usage "$usage_add"; wt_flag="$2"; shift 2 ;;
        -*) usage "$usage_add" ;;
        *) [ -z "$path" ] || usage "$usage_add"; path="$1"; shift ;;
      esac
    done
    [ -n "$path" ] || usage "$usage_add"
    given="$path"
    path="$(cd "$path" 2>/dev/null && pwd)" || finding "not a git repository: $given"
    case "$path" in *[[:space:]]*) finding "project path must not contain whitespace: $path" ;; esac
    if [ -z "$name" ]; then
      name="$(basename "$path")"
      case "$name" in ''|*[!A-Za-z0-9._-]*) finding "folder name '$name' is not usable as a project name; pass --name" ;; esac
      case "$name" in *[!.]*) ;; *) finding "folder name '$name' is not usable as a project name; pass --name" ;; esac
    else
      case "$name" in ''|*[!A-Za-z0-9._-]*) finding "project name must match [A-Za-z0-9._-]+: $name" ;; esac
      case "$name" in *[!.]*) ;; *) finding "project name must not be all dots: $name" ;; esac
    fi
    git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1 || finding "not a git repository: $path"
    grep -q "^- $name " "$registry" && finding "project $name already registered; pass --name to register it under another name"
    other="$(grep -F -- " path=$path " "$registry" | sed -n 's/^- \([^ ]*\) .*/\1/p')"
    [ -z "$other" ] || finding "path $path already registered as $other"
    # One project is one line, and the line is read by splitting on spaces. A
    # label with a space in it would be stored whole and read back cut at the
    # space, so intake would quietly pull the wrong issues. Refuse it here.
    case "$issues" in
      off) ;;
      label:?*) case "${issues#label:}" in
                  *[[:space:]]*) finding "--issues label must not contain spaces: $issues" ;;
                esac ;;
      *) finding "--issues must be off or label:<name>" ;;
    esac
    if [ -z "$base" ]; then base="$(resolve_base "$path")" || exit $?; fi
    valid_branch "$base" || finding "base branch name is not valid: $base"
    if [ -n "$wt_flag" ]; then
      case "$wt_flag" in make|script|git) ;; *) finding "--worktree must be make, script, or git: $wt_flag" ;; esac
      case "$wt_flag" in
        make)   grep -qE '^worktree:' "$path/Makefile" 2>/dev/null || finding "no worktree target in $path/Makefile" ;;
        script) ls "$path"/scripts/*worktree* >/dev/null 2>&1 || finding "no scripts/*worktree* in $path" ;;
      esac
      wt="$wt_flag"
    else
      wt="$(detect_worktree "$path")"
    fi
    template_msg="$(install_template "$path")" || exit $?
    printf -- '- %s path=%s base=%s worktree=%s issues=%s (added %s)\n' \
      "$name" "$path" "$base" "$wt" "$issues" "$(date -u +%Y-%m-%d)" >> "$registry"
    echo "$template_msg"
    log "registered $name base=$base worktree=$wt issues=$issues"
    # bin/dux-install decides what the denylist holds, and it leaves out a name this
    # short. Said again here so the operator hears it when they pick the name.
    if [ "${#name}" -lt 4 ]; then
      log "$name will be left out of the denylist: shorter than four characters, and the lint would match nearly every file; register it under a longer name with dux-project add --name"
    fi ;;
  list) [ $# -eq 0 ] || usage "usage: dux-project list"; sed -n 's/^- \([^ ]*\) .*/\1/p' "$registry" ;;
  get)
    [ $# -eq 2 ] || usage "usage: dux-project get <name> <key>"
    name="$1"; key="$2"
    grep -q "^- $name " "$registry" || finding "project $name not registered"
    field "$name" "$key" ;;
  resolve-base) [ $# -eq 1 ] || usage "usage: dux-project resolve-base <path>"; resolve_base "$1" ;;
  pr-template)
    [ $# -eq 1 ] || usage "usage: dux-project pr-template <path>"
    [ -d "$1" ] || finding "no such directory: $1"
    found="$(find_templates "$1")"
    if [ -n "$found" ]; then printf '%s\n' "$found"; else echo none; fi ;;
  *) usage "usage: dux-project add|list|get|resolve-base|pr-template" ;;
esac
