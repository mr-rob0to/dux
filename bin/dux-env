#!/usr/bin/env bash
# Sourced by every dux script. Never executed directly.
# shellcheck disable=SC2034
set -u

DUX_ROOT="${DUX_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
DUX_HOME="${DUX_HOME:-$DUX_ROOT}"
DUX_DATA="$DUX_HOME/data"
DUX_STATE="$DUX_HOME/state"
DUX_CONFIG="$DUX_HOME/config"
DUX_TASKS="$DUX_DATA/tasks"
mkdir -p "$DUX_DATA" "$DUX_STATE" "$DUX_CONFIG" "$DUX_TASKS"
export DUX_ROOT DUX_HOME DUX_DATA DUX_STATE DUX_CONFIG DUX_TASKS

log()     { printf 'dux: %s\n' "$*" >&2; }
die()     { printf 'dux: %s\n' "$*" >&2; exit 1; }
finding() { printf 'finding: %s\n' "$*" >&2; exit 2; }
now()     { date -u +%Y-%m-%dT%H:%M:%SZ; }

mtime_epoch() {  # $1 path; one epoch timestamp on GNU and BSD stat
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null
}

pid_runs() {  # $1 pid, $2 command-line needle ending at a word boundary
  local command
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$1" 2>/dev/null || return 1
  command="$(ps -ww -o command= -p "$1" 2>/dev/null)" || return 1
  printf '%s\n' "$command" | awk -v needle="$2" '
    { p = index($0, needle); while (p) {
        l = (p == 1 ? "" : substr($0, p - 1, 1))
        r = substr($0, p + length(needle), 1)
        if ((l == "" || l == "/") && (r == "" || r == " ")) found = 1
        rest = substr($0, p + 1); q = index(rest, needle)
        if (!q) break
        p += q
      }
    }
    END { exit !found }'
}

# The one place a task id is accepted, so every script that builds a path from one
# reaches the same answer. "." and ".." would resolve $DUX_TASKS/$id to a parent.
valid_task_id() {  # $1 id; a finding when it is not one
  case "$1" in ''|*[!A-Za-z0-9._-]*) finding "task id must match [A-Za-z0-9._-]+: $1" ;; esac
  case "$1" in *[!.]*) ;; *) finding "task id must not be all dots: $1" ;; esac
}

# The one place a task channel is deleted, so recovery and teardown draw the same
# line. A prefix check on its own is text, and text walks back out or points
# somewhere else: state/channels/../../<anything> starts with the channel
# directory without being in it, a channels/<a> that is a link to channels/<b>
# is another task's live channel, and so is <b>'s own path written down here.
# The wrapper makes the channel with mktemp -d state/channels/<id>.XXXXXXXX and
# records the path the kernel agrees on, so the rule is all three of that: this
# task's name, directly under state/channels/, and exactly what it resolves to.
# A channel already gone is an answer, not a failure.
clear_channel() {  # $1 id, $2 portal file; removes the channel the portal names
  local channel real
  channel="$(cat "$2" 2>/dev/null)"
  case "$channel" in
    "$DUX_STATE/channels/$1."?*) ;;
    ?*) log "state/$1.portal does not name a task channel; left in place"; return 0 ;;
    *) return 0 ;;
  esac
  real="$(cd "$channel" 2>/dev/null && pwd -P)" || real=""
  case "$real" in
    '') log "task channel $channel is already gone" ;;
    "$channel") rm -rf "$channel" 2>/dev/null || log "task channel $channel left in place" ;;
    *) log "state/$1.portal does not name a task channel; left in place" ;;
  esac
}

task_harness() {  # $1 task dir; prints the harness that task would run under
  local h=""
  [ -f "$1/harness" ] && h="$(tr -d '[:space:]' < "$1/harness")"
  if [ -z "$h" ] && [ -f "$DUX_CONFIG/worker-harness" ]; then
    h="$(tr -d '[:space:]' < "$DUX_CONFIG/worker-harness")"
  fi
  printf '%s' "${h:-claude}"
}

# The one place a worker harness is accepted or refused, so the task file, the
# config file and dux-spawn --harness all reach the same answer.
harness_refusal() {  # $1 harness; prints why it cannot run a worker and returns 1
  case "$1" in
    claude) return 0 ;;
    codex) printf 'codex workers are not available: no deny list, so git push --no-verify skips the only guard (milestone 2)' ;;
    *) printf 'unknown worker harness %s (claude)' "$1" ;;
  esac
  return 1
}

strip_dux_bin() {  # $1 a PATH; prints it without Dux's own bin directory
  local rest="$1" e out=""
  while :; do
    e="${rest%%:*}"
    case "$e" in "$DUX_ROOT/bin") ;; *) out="${out:+$out:}$e" ;; esac
    case "$rest" in *:*) rest="${rest#*:}" ;; *) break ;; esac
  done
  printf '%s' "$out"
}

require_cmd() {
  local c
  for c in "$@"; do
    command -v "$c" >/dev/null 2>&1 || die "required command not found: $c"
  done
}

# ---- terminal handoffs ---------------------------------------------------
# A run's terminal state reaches the watcher as one directory under
# state/<id>.handoffs/<n>, built beside its home and moved into place with a
# single rename, so a reader sees a whole handoff or none of it. Sequences are
# retained until teardown: a watcher killed part-way through replays the one it
# was applying instead of losing it.
HANDOFF_LINE_CAP=200

cap_line() {  # $1 text; one clean line of at most 200 characters
  local s
  s="$(printf '%s' "$1" | LC_ALL=C tr -d '\000-\010\013-\037\177' | tr '\t' ' ' | tr -d '\n')"
  [ "${#s}" -le "$HANDOFF_LINE_CAP" ] || s="${s:0:197}..."
  printf '%s' "$s"
}

handoff_home() { printf '%s' "$DUX_STATE/$1.handoffs"; }

# The lowest sequence with no consumed marker. Stops at the first gap, so a
# sequence can never be applied before the one in front of it.
next_handoff() {  # $1 id; prints the sequence, or returns 1
  local d n=1
  d="$(handoff_home "$1")"
  [ -d "$d" ] || return 1
  while [ -d "$d/$n" ]; do
    [ -e "$d/$n/consumed" ] || { printf '%s' "$n"; return 0; }
    n=$((n + 1))
  done
  return 1
}

# The sequence a new handoff takes: one past the highest that exists, consumed
# or not. Recovery proving a late result lands behind whatever the run left.
handoff_next_seq() {  # $1 id
  local d n=1
  d="$(handoff_home "$1")"
  [ -d "$d" ] || { printf 1; return 0; }
  while [ -d "$d/$n" ]; do n=$((n + 1)); done
  printf '%s' "$n"
}

publish_handoff() {  # $1 id, $2 run, $3 status line, $4 event; prints the sequence
  local d tmp n
  d="$(handoff_home "$1")"
  mkdir -p "$d" 2>/dev/null || return 1
  n="$(handoff_next_seq "$1")"
  tmp="$d/.tmp.$2.$n.$$"
  rm -rf "$tmp" 2>/dev/null
  mkdir "$tmp" 2>/dev/null || return 1
  { printf '%s\n' "$2" > "$tmp/run" \
    && printf '%s\n' "$3" > "$tmp/status" \
    && printf '%s\n' "$4" > "$tmp/event"; } || { rm -rf "$tmp"; return 1; }
  mv "$tmp" "$d/$n" 2>/dev/null || { rm -rf "$tmp"; return 1; }
  printf '%s' "$n"
}
