#!/usr/bin/env bash
# Sourced by every dux script. Never executed directly.
# shellcheck disable=SC2034
set -u

DUX_ROOT="${DUX_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
DUX_HOME="${DUX_HOME:-$DUX_ROOT}"
DUX_DATA="$DUX_HOME/data"
DUX_STATE="$DUX_HOME/state"
DUX_CONFIG="$DUX_HOME/config"
DUX_TASKS="$DUX_DATA/tasks"
mkdir -p "$DUX_DATA" "$DUX_STATE" "$DUX_CONFIG" "$DUX_TASKS"
export DUX_ROOT DUX_HOME DUX_DATA DUX_STATE DUX_CONFIG DUX_TASKS

log()     { printf 'dux: %s\n' "$*" >&2; }
die()     { printf 'dux: %s\n' "$*" >&2; exit 1; }
finding() { printf 'finding: %s\n' "$*" >&2; exit 2; }
now()     { date -u +%Y-%m-%dT%H:%M:%SZ; }

mtime_epoch() {  # $1 path; one epoch timestamp on GNU and BSD stat
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null
}

# One reading of "which GitHub repository is this", shared by the result context
# and intake, so a source key and a PR url are compared under the same rule.
github_slug() {  # $1 repo path; prints owner/name, or returns 1
  local url rest auth host slug
  url="$(git -C "$1" config --get remote.origin.url 2>/dev/null)" || return 1
  # The host has to be github.com itself, not a name that merely ends in it.
  # A substring test reads notgithub.com/acme/widgets as the real acme/widgets,
  # and intake would then query and comment on a repository with the operator's
  # own credentials that the operator never registered. Take the authority
  # apart instead: scheme off, then the part before the first / or :, then any
  # user info off that, and require what is left to be exactly github.com.
  rest="${url#*://}"
  auth="${rest%%[/:]*}"
  host="${auth#*@}"
  [ "$host" = github.com ] || return 1
  slug="${rest#"$auth"}"; slug="${slug#[:/]}"; slug="${slug%/}"; slug="${slug%.git}"
  printf '%s' "$slug" | grep -E '^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$' >/dev/null || return 1
  printf '%s' "$slug"
}

pid_runs() {  # $1 pid, $2 command-line needle ending at a word boundary
  local command
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$1" 2>/dev/null || return 1
  command="$(ps -ww -o command= -p "$1" 2>/dev/null)" || return 1
  printf '%s\n' "$command" | awk -v needle="$2" '
    { p = index($0, needle); while (p) {
        l = (p == 1 ? "" : substr($0, p - 1, 1))
        r = substr($0, p + length(needle), 1)
        if ((l == "" || l == "/") && (r == "" || r == " ")) found = 1
        rest = substr($0, p + 1); q = index(rest, needle)
        if (!q) break
        p += q
      }
    }
    END { exit !found }'
}

# Whether a process group still holds anything running. kill -0 is not that
# question: it answers for a zombie too, and a process nobody has waited on stays
# one until its parent gets round to it. Measured on Linux 2026-09-15, tmux left
# a harness it had just killed as [claude] <defunct> for more than thirty
# seconds, and the stop that had just worked read as a group that survived KILL.
# A group of nothing but zombies has gone. A ps that will not answer leaves the
# reading where kill -0 put it, because a group wrongly called gone is a worker
# left running.
group_runs() {  # $1 pgid; 0 while the group holds a process that is not a zombie
  local states
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  kill -0 -- "-$1" 2>/dev/null || return 1
  states="$(ps -A -o pgid=,stat= 2>/dev/null | awk -v g="$1" '$1 == g { print $2 }')" \
    || return 0
  [ -n "$states" ] || return 0
  printf '%s\n' "$states" | awk '$0 !~ /^Z/ { alive = 1 } END { exit !alive }'
}

stop_pgid() {  # $1 pgid; TERM, then KILL; returns 1 if anything is still there
  local i limit signals
  # Tests only: nothing a test can start survives KILL, so without this the
  # branch that refuses a survivor could never be seen to fail.
  signals="${DUX_WRAP_STOP_SIGNALS:-on}"
  group_runs "$1" || return 0
  limit=$(( ${DUX_WRAP_STOP_GRACE_SECS:-10} * 5 ))
  if [ "$signals" = on ]; then kill -TERM -- "-$1" 2>/dev/null || true; fi
  i=0
  while [ "$i" -lt "$limit" ]; do
    group_runs "$1" || return 0
    i=$((i + 1)); sleep 0.2
  done
  log "worker group $1 ignored TERM; killing it"
  if [ "$signals" = on ]; then kill -KILL -- "-$1" 2>/dev/null || true; fi
  i=0
  while [ "$i" -lt 25 ]; do
    group_runs "$1" || return 0
    i=$((i + 1)); sleep 0.2
  done
  return 1
}

# A session parked after its proved delivery sits idle at its prompt, which is
# not a worker at work. The wrapper writes state/<id>.parked only once that run's
# turn has ended, naming the run, itself and the session's group, and it counts
# only while all three still hold: the run is the task's current run, the
# wrapper is the pid state/<id>.pid names and it is still running, and the group
# is the one state/<id>.pgid names. Anything unreadable or out of step is not
# parked, and whatever else is still running is judged as it always was.
parked() {  # $1 id
  local m="$DUX_STATE/$1.parked" run wrapper group
  run="$(sed -n 's/^run=//p' "$m" 2>/dev/null)"
  wrapper="$(sed -n 's/^wrapper=//p' "$m" 2>/dev/null)"
  group="$(sed -n 's/^pgid=//p' "$m" 2>/dev/null)"
  [ -n "$run" ] || return 1
  [ "$run" = "$(sed -n 's/^run=//p' "$DUX_STATE/$1.run" 2>/dev/null)" ] || return 1
  case "$group" in ''|*[!0-9]*) return 1 ;; esac
  [ "$group" = "$(cat "$DUX_STATE/$1.pgid" 2>/dev/null)" ] || return 1
  [ "$wrapper" = "$(cat "$DUX_STATE/$1.pid" 2>/dev/null)" ] && pid_runs "$wrapper" "dux-worker-wrap $1"
}

# One Dux-managed worker at a time. Several long workers spend one subscription
# between them, and the cheapest fix that actually works is to start the second
# one later. This is a refusal and not a queue: no scheduler, no reservation, no
# timer, no automatic start, and nothing to go wrong while nobody is watching.
# The operator runs the same command again once the active task has stopped.
#
# Two signals, the ones Dux already keeps, read for every other registered task.
#
# The pidfile, for any task at all: the wrapper writes it and teardown clears
# it, so a file naming a live process is the strongest evidence there is. It is
# matched against the command line as well, the way dux-recover matches it,
# because a pid the system handed to something else entirely would otherwise
# stop the whole fleet rather than one task. A file that cannot be read, or that
# holds something that is not a pid, blocks: Dux cannot prove the slot is free,
# and guessing free is the one answer that puts two agents on one account.
#
# The container, only for a task Dux still records as running or stale. Both
# backends keep the pane after the command in it exits, so a finished task that
# has not been torn down still has one; reading that as a live worker would
# refuse every spawn until the operator tidied up. Where Dux does believe a
# worker is at work, a pane it can see is evidence and a stuck run blocks the
# next start by design -- the refusal names it, and existing recovery clears it.
#
# A parked session is exempt from both signals, and only while its marker holds.
# Its ledger reading still counts, so one whose result the watcher has not yet
# applied still reads running, and its pane still blocks.
fleet_busy() {  # $1 id; prints "<why> <other>" for a task whose worker may be alive, else returns 1
  local id="$1" ledger="$DUX_ROOT/bin/dux-ledger" backend="$DUX_ROOT/bin/dux-backend" other opid opgid wpid g state at ids idle
  # The roster is read here, on its own line, and not as a command substitution
  # in the loop's here-document: a here-document throws the substitution's exit
  # status away, so a ledger that could not enumerate would read as an empty
  # fleet and let the start straight through. Same rule as below, one step
  # earlier.
  if ! ids="$("$ledger" list 2>/dev/null)"; then printf 'roster -'; return 0; fi
  while IFS= read -r other; do
    [ -n "$other" ] || continue
    [ "$other" = "$id" ] && continue
    opid="$DUX_STATE/$other.pid"
    idle=""; if parked "$other"; then idle=yes; fi
    if [ -z "$idle" ] && { [ -e "$opid" ] || [ -L "$opid" ]; }; then
      wpid="$(cat "$opid" 2>/dev/null)" || { printf 'pidfile %s' "$other"; return 0; }
      case "$wpid" in
        ''|*[!0-9]*) printf 'pidfile %s' "$other"; return 0 ;;
        *) if pid_runs "$wpid" "dux-worker-wrap $other"; then printf 'live %s' "$other"; return 0; fi ;;
      esac
    fi
    # The harness's own group, which outlives its wrapper. A worker sits in a
    # live session now, so a wrapper killed while the session is still at its
    # prompt leaves a pidfile that reads gone and a tab full of agent. Reading
    # only the pidfile would let a second worker start beside it. The pgid file
    # is written once the group is known and cleared at teardown, and its
    # unreadable forms fail closed exactly as the pidfile's do.
    opgid="$DUX_STATE/$other.pgid"
    if [ -z "$idle" ] && { [ -e "$opgid" ] || [ -L "$opgid" ]; }; then
      g="$(cat "$opgid" 2>/dev/null)" || { printf 'pgidfile %s' "$other"; return 0; }
      case "$g" in
        ''|*[!0-9]*) printf 'pgidfile %s' "$other"; return 0 ;;
        *) if kill -0 -- "-$g" 2>/dev/null; then printf 'live %s' "$other"; return 0; fi ;;
      esac
    fi
    # Fail closed, the same way the pidfile does. A ledger or a backend that
    # will not answer about another task is "could not tell", not "free", and
    # answering "free" on no evidence is what puts two agents on one account.
    # The refusal names which of the two went quiet, because they are fixed
    # differently: one is the backlog, the other is the container runner.
    if ! state="$("$ledger" get "$other" state 2>/dev/null)"; then
      printf 'ledger %s' "$other"; return 0
    fi
    case "$state" in
      running|stale)
        if ! at="$("$backend" find "$other" 2>/dev/null)"; then
          printf 'backend %s' "$other"; return 0
        fi
        [ -z "$at" ] || { printf 'live %s' "$other"; return 0; } ;;
    esac
  done <<EOF
$ids
EOF
  return 1
}

first_value() {  # $1 file; the first line that is neither blank nor a note
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in '#'* | '') continue ;; esac
    printf '%s\n' "$line"
    return 0
  done < "$1"
  return 1
}

# How many workers may run at once. A spending brake, not a safety boundary:
# every task has its own worktree, branch, tab and state files at any count, so
# spawn counts from the ledger and evidence about another task blocks nothing.
# The operator's file wins, and only when nothing at all is there is the
# template read. A value that is not a whole number from 1 to 99 is a finding
# and never a default: a limit silently read as another number is a brake the
# operator believes is on.
worker_limit() {  # prints the limit, or a finding
  local f v
  for f in "$DUX_CONFIG/max-workers" "$DUX_ROOT/templates/config/max-workers"; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    v="$(first_value "$f" 2>/dev/null)" || v=""
    case "$v" in [1-9] | [1-9][0-9]) printf '%s\n' "$v"; return 0 ;; esac
    finding "config/max-workers must be a whole number from 1 to 99, not '$(cap_line "$v")'"
  done
  finding "no worker limit in config/max-workers or templates/config/max-workers"
}

# How many tasks the ledger holds as running or stale, which is what spawn holds
# against the limit. A list that fails is "could not count", never a count of
# none. It takes no id: the task asking is queued, which spawn has already
# proved, so it is never in the count.
fleet_running() {  # prints the count, or returns 1 printing nothing
  local ledger="$DUX_ROOT/bin/dux-ledger" running stale
  running="$("$ledger" list --state running 2>/dev/null)" || return 1
  stale="$("$ledger" list --state stale 2>/dev/null)" || return 1
  printf '%s\n%s\n' "$running" "$stale" | awk 'NF { n++ } END { print n + 0 }'
}

# The one place a task id is accepted, so every script that builds a path from one
# reaches the same answer. "." and ".." would resolve $DUX_TASKS/$id to a parent.
valid_task_id() {  # $1 id; a finding when it is not one
  case "$1" in ''|*[!A-Za-z0-9._-]*) finding "task id must match [A-Za-z0-9._-]+: $1" ;; esac
  case "$1" in *[!.]*) ;; *) finding "task id must not be all dots: $1" ;; esac
}

# The one place a task channel is deleted, so recovery and teardown draw the same
# line. A prefix check on its own is text, and text walks back out or points
# somewhere else: state/channels/../../<anything> starts with the channel
# directory without being in it, a channels/<a> that is a link to channels/<b>
# is another task's live channel, and so is <b>'s own path written down here.
# The wrapper makes the channel with mktemp -d state/channels/<id>.XXXXXXXX and
# records the path the kernel agrees on, so the rule is all three of that: this
# task's name, directly under state/channels/, and exactly what it resolves to.
# A channel already gone is an answer, not a failure.
clear_channel() {  # $1 id, $2 portal file; removes the channel the portal names
  local channel real
  channel="$(cat "$2" 2>/dev/null)"
  case "$channel" in
    "$DUX_STATE/channels/$1."?*) ;;
    ?*) log "state/$1.portal does not name a task channel; left in place"; return 0 ;;
    *) return 0 ;;
  esac
  # An id may hold dots, so the name alone is not enough: task a.b's channel is
  # a.b.XXXXXXXX, which starts with task a's name and a dot. The suffix mktemp
  # adds holds none, so a second dot means the channel is another task's.
  case "${channel#"$DUX_STATE/channels/$1."}" in
    *.*) log "state/$1.portal does not name a task channel; left in place"; return 0 ;;
  esac
  real="$(cd "$channel" 2>/dev/null && pwd -P)" || real=""
  case "$real" in
    '') log "task channel $(cap_line "$channel") is already gone" ;;
    "$channel") rm -rf "$channel" 2>/dev/null || log "task channel $(cap_line "$channel") left in place" ;;
    *) log "state/$1.portal does not name a task channel; left in place" ;;
  esac
}

task_harness() {  # $1 task dir; prints the harness that task would run under
  local h=""
  [ -f "$1/harness" ] && h="$(tr -d '[:space:]' < "$1/harness")"
  if [ -z "$h" ] && [ -f "$DUX_CONFIG/worker-harness" ]; then
    h="$(tr -d '[:space:]' < "$DUX_CONFIG/worker-harness")"
  fi
  printf '%s' "${h:-claude}"
}

# The one place a worker harness is accepted or refused, so the task file, the
# config file and dux-spawn --harness all reach the same answer.
harness_refusal() {  # $1 harness; prints why it cannot run a worker and returns 1
  case "$1" in
    claude) return 0 ;;
    codex) printf 'codex workers are not available: no deny list, so git push --no-verify skips the only guard (milestone 2)' ;;
    *) printf 'unknown worker harness %s (claude)' "$1" ;;
  esac
  return 1
}

strip_dux_bin() {  # $1 a PATH; prints it without Dux's own bin directory
  local rest="$1" e out=""
  while :; do
    e="${rest%%:*}"
    case "$e" in "$DUX_ROOT/bin") ;; *) out="${out:+$out:}$e" ;; esac
    case "$rest" in *:*) rest="${rest#*:}" ;; *) break ;; esac
  done
  printf '%s' "$out"
}

require_cmd() {
  local c
  for c in "$@"; do
    command -v "$c" >/dev/null 2>&1 || die "required command not found: $c"
  done
}

# ---- terminal handoffs ---------------------------------------------------
# A run's terminal state reaches the watcher as one directory under
# state/<id>.handoffs/<n>, built beside its home and moved into place with a
# single rename, so a reader sees a whole handoff or none of it. Sequences are
# retained until teardown: a watcher killed part-way through replays the one it
# was applying instead of losing it.
HANDOFF_LINE_CAP=200

# Deleting the ASCII control bytes kills terminal escape sequences, but the
# characters that reorder what a terminal draws are multi-byte and survive it:
# the direction overrides and isolates, the zero-width characters, the byte
# order mark and the Arabic letter mark. An issue author can use them to make a
# line render as something other than what it says, and the reader is the
# operator deciding whether to dispatch. Strip exactly those and nothing else,
# so accented, non-Latin and emoji text still reads as itself.
# The byte patterns are built with octal escapes on purpose: no invisible
# character ever appears in this file, where nobody could see it.
strip_format_chars() {  # filter; stdin to stdout
  LC_ALL=C sed "$(printf 's/\342\200[\213-\217\252-\256]//g; s/\342\201[\246-\251]//g; s/\357\273\277//g; s/\330\234//g')"
}

cap_line() {  # $1 text; one clean line of at most 200 characters
  local s
  s="$(printf '%s' "$1" | LC_ALL=C tr -d '\000-\010\013-\037\177' | strip_format_chars | tr '\t' ' ' | tr -d '\n')"
  [ "${#s}" -le "$HANDOFF_LINE_CAP" ] || s="${s:0:197}..."
  printf '%s' "$s"
}

# Take the front of a stream without leaving the producer writing into a closed
# pipe. `producer | head -c N` stops reading at N and closes the pipe, and a
# producer that handles SIGPIPE rather than dying on it then reports the failed
# write on stderr: jq says "writing output failed: Broken pipe", GNU sed
# "couldn't flush stdout". Dux prints findings on stderr and nothing else, so
# that line is read as one. Reading the rest away costs nothing and removes the
# whole class. Reading a file directly, `head -c N file`, has no producer and
# needs neither of these.
take_bytes() { head -c "$1"; cat >/dev/null; }   # $1 bytes; filter
take_line()  { head -n 1;    cat >/dev/null; }   # first line only; filter

handoff_home() { printf '%s' "$DUX_STATE/$1.handoffs"; }

# The lowest sequence with no consumed marker. Stops at the first gap, so a
# sequence can never be applied before the one in front of it.
next_handoff() {  # $1 id; prints the sequence, or returns 1
  local d n=1
  d="$(handoff_home "$1")"
  [ -d "$d" ] || return 1
  while [ -d "$d/$n" ]; do
    [ -e "$d/$n/consumed" ] || { printf '%s' "$n"; return 0; }
    n=$((n + 1))
  done
  return 1
}

# The sequence a new handoff takes: one past the highest that exists, consumed
# or not. Recovery proving a late result lands behind whatever the run left.
handoff_next_seq() {  # $1 id
  local d n=1
  d="$(handoff_home "$1")"
  [ -d "$d" ] || { printf 1; return 0; }
  while [ -d "$d/$n" ]; do n=$((n + 1)); done
  printf '%s' "$n"
}

publish_handoff() {  # $1 id, $2 run, $3 status line, $4 event; prints the sequence
  local d tmp n
  d="$(handoff_home "$1")"
  mkdir -p "$d" 2>/dev/null || return 1
  n="$(handoff_next_seq "$1")"
  tmp="$d/.tmp.$2.$n.$$"
  rm -rf "$tmp" 2>/dev/null
  mkdir "$tmp" 2>/dev/null || return 1
  { printf '%s\n' "$2" > "$tmp/run" \
    && printf '%s\n' "$3" > "$tmp/status" \
    && printf '%s\n' "$4" > "$tmp/event"; } || { rm -rf "$tmp"; return 1; }
  mv "$tmp" "$d/$n" 2>/dev/null || { rm -rf "$tmp"; return 1; }
  printf '%s' "$n"
}
